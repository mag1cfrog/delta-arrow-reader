    },
    {
      "id": "deep_quoted_and_unqualified",
      "input": "struct_mixed",
      "sql": "SELECT id, (SELECT STRUCT(q.nested.inner.leaf AS deep, q.quoted.`a.b` AS dotted, q.quoted.`sp ace` AS spaced, q.quoted.`back``tick` AS escaped, nested.item AS unqualified)) AS r FROM struct_mixed q ORDER BY id",
      "ordered": true
    },
    {
      "id": "local_and_outer_shadowing",
      "input": "struct_mixed",
      "sql": "SELECT id, (SELECT STRUCT(nested.item AS local_value, q.nested.item AS outer_value) FROM (SELECT NAMED_STRUCT('item', 99L) AS nested) i) AS r FROM struct_mixed q ORDER BY id",
      "ordered": true
    },
    {
      "id": "outer_qualified_name_priority",
      "input": "struct_mixed",
      "sql": "SELECT q.id, (SELECT q.nested.item) AS r FROM (SELECT id, nested, NAMED_STRUCT('nested', NAMED_STRUCT('item', 99L)) AS q FROM struct_mixed) q ORDER BY q.id",
      "ordered": true
    },
    {
      "id": "unaliased_struct_child",
      "input": "struct_mixed",
      "sql": "SELECT id, (SELECT STRUCT(q.nested.item)) AS r FROM struct_mixed q ORDER BY id",
      "ordered": true
    },
    {
      "id": "outer_nested_in_inner_filter",
      "input": "struct_mixed",
      "sql": "SELECT id, (SELECT COUNT(*) FROM VALUES (-3), (3), (3) i(k) WHERE i.k = q.nested.item) AS r FROM struct_mixed q ORDER BY id",
      "ordered": true
    },
    {
      "id": "plain_outer_in_inner_filter",
      "input": "struct_mixed",
      "sql": "SELECT q.id, (SELECT count(*) FROM VALUES (-2),(2),(2) i(k) WHERE i.k=q.v) AS r FROM struct_mixed q ORDER BY q.id",
      "ordered": true
    }
