    {
      "id": "qualified_alias_chain",
      "sql": "SELECT consumer.key[0] AS element,n FROM (SELECT key,n FROM (SELECT ARRAY(CAST('-0.0' AS FLOAT)) AS key,COUNT(*) AS n FROM float_scalar_mixed GROUP BY ARRAY(CAST('-0.0' AS FLOAT))) producer) consumer",
      "category": "literal_consumer_boundary"
    },
