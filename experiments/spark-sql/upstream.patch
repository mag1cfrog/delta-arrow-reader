-        }
-    }
-
-    fn consume_node(&mut self) -> bool {
-        if self.remaining_nodes == 0 {
-            return false;
-        }
-        self.remaining_nodes -= 1;
-        true
-    }
-
-    fn is_exhausted(&self) -> bool {
