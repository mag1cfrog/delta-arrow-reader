-            let Some(source_list) = source.as_any().downcast_ref::<ListArray>() else {
-                return exec_err!(
-                    "Cannot cast column of type {} to list type. Source must be a list to cast to list.",
-                    source.data_type()
-                );
-            };
-            let casted_values = cast_array_with_schema_evolution_inner(
-                source_list.values(),
-                target_elem.as_ref(),
-                cast_options,
-                matching,
-                relaxed_timezone,
-            )?;
