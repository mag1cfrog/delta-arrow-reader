-fn merge_name_key(name: &str, case_sensitive: bool) -> String {
-    if case_sensitive {
-        name.to_string()
-    } else {
-        name.to_ascii_lowercase()
-    }
-}
-
-fn merge_names_equal(left: &str, right: &str, case_sensitive: bool) -> bool {
-    if case_sensitive {
-        left == right
-    } else {
-        left.eq_ignore_ascii_case(right)
-    }
-}
