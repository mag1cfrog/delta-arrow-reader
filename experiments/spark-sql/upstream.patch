-) -> Result<(), Box<dyn std::error::Error>> {
-    println!("cargo:rerun-if-changed={}", path.display());
-    let mut entries = std::fs::read_dir(path)?.collect::<Result<Vec<_>, _>>()?;
-    entries.sort_by_key(|entry| entry.path());
-    for entry in entries {
-        let path = entry.path();
