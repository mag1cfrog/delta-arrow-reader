-            }
-        }
-    }
-
-    for clause in options.not_matched_by_target_clauses.iter_mut() {
-        if let MergeNotMatchedByTargetAction::InsertColumns { columns, .. } = &mut clause.action {
-            for col in columns.iter_mut() {
-                *col = normalize(col, target_map);
-            }
-        }
-    }
-}
