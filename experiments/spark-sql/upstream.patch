-                    .map(|(column, field)| {
-                        let expr = col(column).cast_to(field.data_type(), input.schema())?;
-                        Ok(Self::make_nullable_if_needed(expr, field, input.schema())?
-                            .alias(field.name()))
-                    })
-                    .collect::<PlanResult<Vec<_>>>()?;
