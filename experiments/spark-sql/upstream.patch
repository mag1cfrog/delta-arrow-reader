-    fn validate_merge_star_columns(
-        &self,
-        matched_clauses: &[MergeMatchedClause],
-        not_matched_by_target_clauses: &[MergeNotMatchedByTargetClause],
-        target_schema: &datafusion_common::DFSchemaRef,
