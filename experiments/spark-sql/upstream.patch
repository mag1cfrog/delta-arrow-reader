-    fn validate_store_assignment_type(
-        &self,
-        write_type: &DataType,
-        target_type: &DataType,
-        target_name: &str,
-    ) -> PlanResult<()> {
-        if store_assignment_compatible(
-            write_type,
-            target_type,
