-            WriteMode::ErrorIfExists => Ok(SinkMode::ErrorIfExists),
-            WriteMode::IgnoreIfExists => Ok(SinkMode::IgnoreIfExists),
-            WriteMode::Append { .. } => Ok(SinkMode::Append),
-            WriteMode::Replace { .. } | WriteMode::Truncate => Ok(SinkMode::Overwrite),
