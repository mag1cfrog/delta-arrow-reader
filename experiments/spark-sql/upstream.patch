-            if &source_len != target_len {
-                return exec_err!(
-                    "Cannot cast fixed size list with length {} to length {}",
-                    source_len,
-                    target_len
-                );
-            }
-            let casted_values = cast_array_with_schema_evolution_inner(
-                source_list.values(),
-                target_elem.as_ref(),
-                cast_options,
-                matching,
-                relaxed_timezone,
-            )?;
