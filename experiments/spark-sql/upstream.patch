-                source_map.offsets().clone(),
-                new_entries,
-                source_map.nulls().cloned(),
-                *ordered,
-            )?))
-        }
-        _ => Ok(cast_with_options(
-            source,
-            target_field.data_type(),
-            cast_options,
-        )?),
-    }
-}
