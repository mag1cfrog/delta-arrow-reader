-        TARGET_PRESENT_COLUMN,
-        SOURCE_PRESENT_COLUMN,
-        TARGET_ROW_ID_COLUMN,
-        OPERATION_COLUMN,
-        MERGE_SOURCE_METRIC_COLUMN,
-    ]
-    .into_iter()
-    .chain(format_columns.iter().copied());
