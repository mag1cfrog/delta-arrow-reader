-            acc_exprs.push(f);
-        }
-
-        let final_expr: Expr = acc_exprs.into_iter().reduce(or).unwrap_or(lit(false));
-        Ok(LogicalPlanBuilder::from(plan_with_rand)
-            .filter(final_expr)?
-            .build()?)
-    }
