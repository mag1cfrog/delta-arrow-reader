-    fn priority(self) -> i32 {
-        match self {
-            Self::Object | Self::List => -1,
-            Self::Boolean => 0,
-            Self::Int64 => 1,
-            Self::Float64 => 2,
-            Self::Decimal => 3,
-            Self::Date => 4,
-            Self::Time => 5,
-            Self::TimestampMicros => 6,
-            Self::TimestampNtzMicros => 7,
-            Self::Binary => 8,
-            Self::String => 9,
-            Self::TimestampNanos => 10,
-            Self::TimestampNtzNanos => 11,
-            Self::Uuid => 12,
-        }
-    }
