-                b1.num_buckets == b2.num_buckets
-                    && b1.columns.len() == b2.columns.len()
-                    && b1
-                        .columns
-                        .iter()
-                        .zip(&b2.columns)
-                        .all(|(a, b)| a.eq_ignore_ascii_case(b))
-            }
-            (Some(_), None) => false,
-        };
-        let sort_by_match = match (sort_by, self.sort_by.as_slice()) {
-            ([], _) => true,
-            (_, []) => false,
-            (s1, s2) => {
