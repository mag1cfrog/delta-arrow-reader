-            spec::MergeSource::Query { input, alias } => {
-                let mut plan = self.resolve_query_plan(*input, state).await?;
-                let alias_string = alias.as_ref().map(|a| a.as_ref().to_string());
-                if let Some(alias) = alias_string.as_ref() {
