-            let Some(source_list) = source.as_any().downcast_ref::<FixedSizeListArray>() else {
-                return exec_err!(
-                    "Cannot cast column of type {} to fixed size list type. Source must be a fixed size list to cast to fixed size list.",
-                    source.data_type()
-                );
-            };
