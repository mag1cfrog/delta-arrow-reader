-                OptionLayer::OptionList { items } => items,
-                OptionLayer::TablePropertyList { items } => items,
-                _ => continue,
-            };
-            if let Some(v) = items.iter().find_map(|(k, v)| {
-                if k.eq_ignore_ascii_case(key) {
-                    Some(v.clone())
