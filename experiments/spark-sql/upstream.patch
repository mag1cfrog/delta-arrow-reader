-    let residual_filter = combine_conjunction(&options.residual_predicates);
-
-    let join = Join::try_new(
-        Arc::new(augmented_target),
-        Arc::new(augmented_source),
-        join_on,
-        residual_filter,
-        JoinType::Full,
-        JoinConstraint::On,
-        NullEquality::NullEqualsNothing,
-        false,
