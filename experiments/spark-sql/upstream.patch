-        .get(DELTA_INVARIANTS_METADATA_KEY)
-        .and_then(|raw| {
-            serde_json::from_str::<serde_json::Value>(raw)
-                .ok()
-                .and_then(|value| expression_from_value(&value))
-        })
-}
