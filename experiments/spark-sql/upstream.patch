-        };
-        let init_exprs: Vec<Expr> = input
-            .schema()
-            .columns()
-            .iter()
-            .map(|col| Expr::Column(col.clone()))
-            .collect();
-        let mut all_exprs: Vec<Expr> = init_exprs.clone();
