-fn build_source_metric_plan(
-    source_plan: LogicalPlan,
-    target_schema: &DFSchemaRef,
-    path_column: &str,
-    row_index_column: Option<&str>,
-    row_delete_metadata_columns: &[&str],
-) -> Result<LogicalPlan> {
-    let source_count = Expr::AggregateFunction(AggregateFunction {
-        func: count_udaf(),
