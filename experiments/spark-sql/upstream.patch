-fn integral_decimal_precision(data_type: &DataType) -> Option<u8> {
-    match data_type {
-        DataType::Int8 | DataType::UInt8 => Some(3),
-        DataType::Int16 | DataType::UInt16 => Some(5),
-        DataType::Int32 | DataType::UInt32 => Some(10),
