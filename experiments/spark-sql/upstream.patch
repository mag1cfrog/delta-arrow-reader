-pub fn is_streaming_plan(plan: &LogicalPlan) -> Result<bool> {
-    plan.exists(|plan| {
-        if let LogicalPlan::TableScan(scan) = plan {
-            Ok(source_as_provider(&scan.source)
-                .is_ok_and(|p| is_streaming_table_provider(p.as_ref())))
-        } else {
-            Ok(false)
-        }
-    })
-}
