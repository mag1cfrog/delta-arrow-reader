-            .iter()
-            .map(|(key, _)| key.as_str())
-            .find(|key| strip_delta_check_constraint_prefix(key).is_some()),
-        spec::AlterTableOperation::UnsetTableProperties { keys, .. } => keys
-            .iter()
-            .map(|key| key.as_str())
-            .find(|key| strip_delta_check_constraint_prefix(key).is_some()),
-        _ => None,
-    }
-}
-
-fn quote_delta_identifier(name: &str) -> String {
-    format!("`{}`", name.replace('`', "``"))
-}
