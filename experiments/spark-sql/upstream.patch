-    if options.analyze {
-        // Run the plan to populate metrics. Ignore the output batches.
-        if let Some(plan) = physical {
-            let _ = collect(Arc::clone(plan), ctx.task_ctx()).await?;
-        }
-    }
-    Ok(())
-}
