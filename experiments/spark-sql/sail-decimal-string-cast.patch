diff --git a/experiments/spark-sql/vendor/sail/crates/sail-function/src/scalar/spark_cast_string_to_decimal.rs b/experiments/spark-sql/vendor/sail/crates/sail-function/src/scalar/spark_cast_string_to_decimal.rs
