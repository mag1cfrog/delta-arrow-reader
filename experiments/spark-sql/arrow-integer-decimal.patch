     #[test]
+    fn test_integer_decimal_infallible_boundaries() {
+        fn check<T, D>(values: Vec<T::Native>, digits: u8)
+        where
+            T: ArrowPrimitiveType,
+            T::Native: Into<i128>,
+            D: DecimalType,
+            D::Native: DecimalCast,
+        {
+            // Leave a nonzero offset in both the values and validity buffers.
+            let input = PrimitiveArray::<T>::from_iter(
+                std::iter::once(None)
+                    .chain(values.into_iter().map(Some))
+                    .chain([None]),
+            );
+            let input = input.slice(1, input.len() - 1);
+            if digits > D::MAX_PRECISION {
+                return;
+            }
+            for scale in 0..=(D::MAX_PRECISION - digits) as i8 {
+                for precision in [digits + scale as u8, D::MAX_PRECISION] {
+                    let factor = i256::from_i128(10).checked_pow(scale as u32).unwrap();
+                    let expected = input
+                        .iter()
+                        .map(|v| v.map(|v| i256::from_i128(v.into()).checked_mul(factor).unwrap()))
+                        .collect::<Vec<_>>();
+                    for safe in [true, false] {
+                        let target = PrimitiveArray::<D>::new_null(0)
+                            .with_precision_and_scale(precision, scale)
+                            .unwrap();
+                        let actual = cast_with_options(
+                            &input,
+                            target.data_type(),
+                            &CastOptions {
+                                safe,
+                                ..Default::default()
+                            },
+                        )
+                        .unwrap();
+                        let actual = actual.as_primitive::<D>();
+                        assert_eq!(actual.data_type(), target.data_type());
+                        assert_eq!(
+                            actual
+                                .iter()
+                                .map(|v| v.map(|v| v.to_i256().unwrap()))
+                                .collect::<Vec<_>>(),
+                            expected,
+                            "{:?} -> {:?}, safe={safe}",
+                            T::DATA_TYPE,
+                            target.data_type()
+                        );
+                        for empty in [input.slice(0, 0), PrimitiveArray::<T>::new_null(3)] {
+                            let out = cast_with_options(
+                                &empty,
+                                target.data_type(),
+                                &CastOptions {
+                                    safe,
+                                    ..Default::default()
+                                },
+                            )
+                            .unwrap();
+                            assert_eq!(out.len(), empty.len());
+                            assert_eq!(out.null_count(), empty.len());
+                        }
+                    }
+                }
+            }
+        }
+        macro_rules! check_integer {
