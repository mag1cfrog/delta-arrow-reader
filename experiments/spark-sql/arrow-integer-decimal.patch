+                check::<$arrow, Decimal32Type>(values.clone(), $digits);
+                check::<$arrow, Decimal64Type>(values.clone(), $digits);
+                check::<$arrow, Decimal128Type>(values.clone(), $digits);
+                check::<$arrow, Decimal256Type>(values, $digits);
+            };
+        }
+        check_integer!(Int8Type, i8, 3);
+        check_integer!(UInt8Type, u8, 3);
+        check_integer!(Int16Type, i16, 5);
+        check_integer!(UInt16Type, u16, 5);
+        check_integer!(Int32Type, i32, 10);
+        check_integer!(UInt32Type, u32, 10);
+        check_integer!(Int64Type, i64, 19);
+        check_integer!(UInt64Type, u64, 20);
+
