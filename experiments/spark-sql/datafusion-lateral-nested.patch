+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::test::test_table_scan_with_name;
+    use crate::{Optimizer, OptimizerContext};
+    use arrow::datatypes::DataType;
+    use datafusion_common::Spans;
+    use datafusion_expr::{cast, col, lit, out_ref_col};
+    use datafusion_functions_aggregate::expr_fn::count;
+
+    #[test]
+    fn chained_lateral_joins_preserve_outputs_in_one_pass() -> Result<()> {
+        let lateral =
+            |left, table: &str, alias: &str, outer: &str, data_type: DataType| {
+                let input = LogicalPlanBuilder::from(test_table_scan_with_name(table)?)
+                    .filter(
+                        cast(col(format!("{table}.a")), data_type.clone())
+                            .eq(out_ref_col(data_type, outer)),
+                    )?
+                    .aggregate(Vec::<Expr>::new(), vec![count(lit(1_i64))])?
+                    .project(vec![count(lit(1_i64)).alias("n")])?
+                    .build()?;
+                let outer_ref_columns = input.all_out_ref_exprs();
+                let right = LogicalPlanBuilder::from(LogicalPlan::Subquery(Subquery {
+                    subquery: Arc::new(input),
+                    outer_ref_columns,
+                    spans: Spans::new(),
+                }))
+                .alias(alias)?
+                .build()?;
+                LogicalPlanBuilder::from(left).cross_join(right)?.build()
+            };
+        let first = lateral(
+            test_table_scan_with_name("o")?,
+            "i",
+            "t",
+            "o.a",
+            DataType::UInt32,
+        )?;
+        let rule = DecorrelateLateralJoin::new();
+        let config = OptimizerContext::new().with_max_passes(1);
+        let rewritten = rule.rewrite(first.clone(), &config)?.data;
+        assert_eq!(rewritten.schema().columns(), first.schema().columns());
+
+        let chained = lateral(first, "j", "u", "t.n", DataType::Int64)?;
+        let expected = chained.schema().columns();
+        let optimized = Optimizer::with_rules(vec![Arc::new(rule)]).optimize(
+            chained,
+            &config,
+            |_, _| {},
+        )?;
+        assert_eq!(optimized.schema().columns(), expected);
+        assert_eq!(
+            optimized.apply_with_subqueries(|plan| Ok(
+                if plan.contains_outer_reference() {
+                    TreeNodeRecursion::Stop
+                } else {
+                    TreeNodeRecursion::Continue
+                }
+            ))?,
+            TreeNodeRecursion::Continue,
+            "{}",
+            optimized.display_indent_schema(),
+        );
+        Ok(())
+    }
+}
