+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::test::test_table_scan_with_name;
+    use arrow::datatypes::DataType;
+    use datafusion_common::TableReference;
+    use datafusion_expr::{col, out_ref_col};
+    use datafusion_functions_aggregate::expr_fn::count;
+
+    #[test]
+    fn aliases_preserve_pulled_up_fields_and_filters() -> Result<()> {
+        let alias = TableReference::bare("Z.Mixed");
+        let filtered = LogicalPlanBuilder::from(test_table_scan_with_name("i")?)
+            .filter(col("i.a").eq(out_ref_col(DataType::UInt32, "o.a")))?
+            .build()?;
+        for (alias_above_aggregate, output_name, key_name) in
+            [(true, "n", "a"), (false, "n", "a"), (true, "a", "a:1")]
+        {
+            let aggregate = |input: LogicalPlan| {
+                LogicalPlanBuilder::from(input)
+                    .aggregate(Vec::<Expr>::new(), vec![count(lit(1_i64))])?
+                    .project(vec![count(lit(1_i64)).alias_qualified(
+                        (output_name == "a").then(|| TableReference::bare("agg")),
+                        output_name,
+                    )])?
+                    .build()
+            };
+            let input = if alias_above_aggregate {
+                aggregate(filtered.clone())?
+            } else {
+                // Projection pruning can hide a key while its correlated filter
+                // still waits for the next lateral-decorrelation pass.
+                LogicalPlanBuilder::from(filtered.clone())
+                    .project(Vec::<Expr>::new())?
+                    .build()?
+            };
+            let aliased = LogicalPlanBuilder::from(input)
+                .alias(alias.clone())?
+                .build()?;
+            let plan = if alias_above_aggregate {
+                LogicalPlanBuilder::from(aliased)
+                    .project(vec![Expr::Column(Column::new(
+                        Some(alias.clone()),
+                        output_name,
+                    ))])?
+                    .build()?
+            } else {
+                aggregate(aliased)?
+            };
+            let mut pull_up =
+                PullUpCorrelatedExpr::new().with_need_handle_count_bug(true);
+            let rewritten = plan.rewrite(&mut pull_up).data()?;
+            let key = Column::new(Some(alias.clone()), key_name);
+            assert!(rewritten.schema().has_column(&key));
+            assert!(
+                rewritten
+                    .schema()
+                    .has_column(&Column::new_unqualified(UN_MATCHED_ROW_INDICATOR,))
+            );
+            assert_eq!(pull_up.join_filters, vec![Expr::Column(key).eq(col("o.a"))],);
+            assert!(pull_up.can_pull_up);
+        }
+        Ok(())
+    }
+}
