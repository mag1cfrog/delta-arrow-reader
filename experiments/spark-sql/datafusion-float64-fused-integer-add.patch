+    #[test]
+    fn float64_add_fused_integer_cast_matches_separate_cast() -> Result<()> {
+        use crate::expressions::CastExpr;
+        use arrow::compute::CastOptions;
+        use arrow::compute::kernels::numeric::add;
+
+        let bits = |value: ColumnarValue, len| {
+            Ok::<_, datafusion_common::DataFusionError>(
+                value
+                    .into_array(len)?
+                    .as_primitive::<Float64Type>()
+                    .iter()
+                    .map(|v| v.map(f64::to_bits))
+                    .collect::<Vec<_>>(),
+            )
+        };
+        let floats = [
+            0.0,
+            -0.0,
+            1.25,
+            -2.5,
+            f32::from_bits(1),
+            f32::MIN_POSITIVE,
+            f32::MAX,
+            f32::INFINITY,
+            f32::NEG_INFINITY,
+            f32::NAN,
+        ];
+        let integers = [
+            i64::MIN,
+            i64::MAX,
+            -(1_i64 << 53) - 1,
+            (1_i64 << 53) - 1,
+            1_i64 << 53,
+            (1_i64 << 53) + 1,
+            -1,
+            0,
+            1,
+        ];
+        for len in [0, 1, 17, 8192] {
+            for nulls in [false, true] {
+                let input: Float32Array = (0..len)
+                    .map(|i| (!(nulls && i % 3 == 0)).then_some(floats[i % floats.len()]))
+                    .collect();
+                let shared = input.unary::<_, Float64Type>(|v| v as f64);
+                let right: Int64Array = (0..len)
+                    .map(|i| (!(nulls && i % 5 == 0)).then_some(integers[i % integers.len()]))
+                    .collect();
+                let text: StringArray = (0..len)
+                    .map(|i| match i % 3 {
+                        0 => Some("1.25"),
+                        1 => Some("invalid"),
+                        _ => None,
+                    })
+                    .collect();
+                let batch = RecordBatch::try_from_iter([
+                    ("f32", Arc::new(input) as ArrayRef),
+                    ("f64", Arc::new(shared) as ArrayRef),
+                    ("i64", Arc::new(right) as ArrayRef),
+                    ("text", Arc::new(text) as ArrayRef),
+                ])?;
+                for safe in [false, true] {
+                    let options = CastOptions {
+                        safe,
+                        ..Default::default()
+                    };
+                    for unique_left in [false, true] {
+                        let left: Arc<dyn PhysicalExpr> = if unique_left {
+                            Arc::new(CastExpr::new(
+                                Arc::new(Column::new("f32", 0)),
+                                DataType::Float64,
+                                Some(options.clone()),
+                            ))
+                        } else {
+                            Arc::new(Column::new("f64", 1))
+                        };
+                        // Include non-Int64 casts to exercise the unchanged cast fallback.
+                        let sources: Vec<Arc<dyn PhysicalExpr>> = vec![
+                            Arc::new(Column::new("i64", 2)),
+                            Arc::new(Column::new("f32", 0)),
+                            Arc::new(Column::new("text", 3)),
+                            Arc::new(Literal::new(ScalarValue::Int64(Some(i64::MAX)))),
+                            Arc::new(Literal::new(ScalarValue::Int64(None))),
+                        ];
+                        for source in sources {
+                            let right: Arc<dyn PhysicalExpr> = Arc::new(CastExpr::new(
+                                source,
+                                DataType::Float64,
+                                Some(options.clone()),
+                            ));
+                            let expected = left
+                                .evaluate(&batch)
+                                .and_then(|left| {
+                                    right
+                                        .evaluate(&batch)
+                                        .and_then(|right| apply(&left, &right, add))
+                                })
+                                .and_then(|value| bits(value, len));
+                            for fail_on_overflow in [false, true] {
+                                let expression = BinaryExpr::new(
+                                    Arc::clone(&left),
+                                    Operator::Plus,
+                                    Arc::clone(&right),
+                                )
+                                .with_fail_on_overflow(fail_on_overflow);
+                                let actual = expression.evaluate(&batch).and_then(|v| bits(v, len));
+                                match (&expected, actual) {
+                                    (Ok(expected), Ok(actual)) => assert_eq!(*expected, actual),
+                                    (Err(expected), Err(actual)) => {
+                                        assert_eq!(expected.to_string(), actual.to_string())
+                                    }
+                                    other => panic!("different fused cast outcome: {other:?}"),
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
         Ok(())
     }
 
