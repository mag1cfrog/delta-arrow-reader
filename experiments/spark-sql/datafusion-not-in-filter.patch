+#[cfg(test)]
+#[test]
+fn column_free_not_in_preserves_unknown() -> datafusion_common::Result<()> {
+    use crate::{
+        Optimizer, OptimizerContext,
+        decorrelate_predicate_subquery::DecorrelatePredicateSubquery,
+        push_down_filter::PushDownFilter,
+    };
+    use arrow::datatypes::{DataType, Field, Schema};
+    use datafusion_common::{ScalarValue, tree_node::{TreeNode, TreeNodeRecursion}};
+    use datafusion_expr::{
+        Expr, LogicalPlan, LogicalPlanBuilder, builder::table_source, col,
+        in_subquery, lit, not_in_subquery, out_ref_col,
+    };
+    use std::sync::Arc;
+
+    for null_left in [false, true] {
+        for nullable_right in [false, true] {
+            for correlated in [false, true] {
+                for negated in [false, true] {
+                    let outer = LogicalPlanBuilder::scan(
+                        "o", table_source(&Schema::new(vec![Field::new("x", DataType::Int64, true)])), None,
+                    )?.build()?;
+                    let mut inner = LogicalPlanBuilder::scan(
+                        "t", table_source(&Schema::new(vec![Field::new("v", DataType::Int64, nullable_right)])), None,
+                    )?;
+                    if correlated {
+                        inner = inner.filter(col("t.v").eq(out_ref_col(DataType::Int64, "o.x")))?;
+                    }
+                    let inner = Arc::new(inner.project(vec![col("t.v")])?.build()?);
+                    let lhs = if null_left { lit(ScalarValue::Int64(None)) } else { lit(7_i64) };
+                    let predicate = if negated { not_in_subquery(lhs, inner) } else { in_subquery(lhs, inner) };
+                    let plan = LogicalPlanBuilder::from(outer).filter(predicate)?.build()?;
+                    let mut unknown_checks = 0;
+                    let optimized = Optimizer::with_rules(vec![
+                        Arc::new(DecorrelatePredicateSubquery::new()),
+                        Arc::new(PushDownFilter::new()),
+                    ]).optimize(plan, &OptimizerContext::new(), |_, _| {})?;
+                    optimized.apply(|node| {
+                        for expr in node.expressions() {
+                            expr.apply(|expr| {
+                                if matches!(expr, Expr::IsNotFalse(_)) { unknown_checks += 1; }
+                                Ok(TreeNodeRecursion::Continue)
+                            })?;
+                        }
+                        if negated && let LogicalPlan::Join(join) = node {
+                            assert!(!join.null_aware, "filter must encode NULL handling without the hash-only flag");
+                        }
+                        Ok(TreeNodeRecursion::Continue)
+                    })?;
+                    assert_eq!(unknown_checks, usize::from(negated), "{}", optimized.display_indent());
+                }
+            }
+        }
+    }
+    Ok(())
+}
