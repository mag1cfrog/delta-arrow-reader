     #[test]
+    fn simplify_case_null_conditions() -> datafusion_common::Result<()> {
+        use crate::simplify_expressions::{ExprSimplifier, SimplifyContext};
+        use arrow::datatypes::{DataType, Field, Schema};
+        use datafusion_common::{DFSchema, ScalarValue};
+        use datafusion_expr::{Case, Expr, col, lit};
+        use std::sync::Arc;
+
+        for data_type in [
+            DataType::Int64,
+            DataType::Boolean,
+            DataType::Utf8,
+            DataType::Decimal128(12, 3),
+        ] {
+            let schema = Arc::new(DFSchema::try_from(Schema::new(vec![
+                Field::new("discarded", data_type.clone(), false),
+                Field::new("value", data_type.clone(), false),
+                Field::new("flag", DataType::Boolean, true),
+            ]))?);
+            let simplifier =
+                ExprSimplifier::new(SimplifyContext::builder().with_schema(schema).build());
+            for condition in [lit(ScalarValue::Boolean(None)), lit(ScalarValue::Null)] {
+                let dead = (Box::new(condition), Box::new(col("discarded")));
+                for branches in [
+                    vec![dead.clone()],
+                    vec![
+                        (Box::new(lit(false)), Box::new(col("discarded"))),
+                        dead.clone(),
+                    ],
+                ] {
+                    let with_else = Expr::Case(Case::new(
+                        None,
+                        branches.clone(),
+                        Some(Box::new(col("value"))),
+                    ));
+                    assert_eq!(
+                        simplifier.simplify_algebraic_once(with_else.clone())?.data,
+                        col("value")
+                    );
+                    assert_eq!(simplifier.simplify(with_else)?, col("value"));
+                    let without_else = Expr::Case(Case::new(None, branches, None));
+                    assert_eq!(
+                        simplifier.simplify_algebraic_once(without_else)?.data,
+                        lit(ScalarValue::try_new_null(&data_type)?)
+                    );
+                }
+                // A nullable column can be true. Keep its position and branch.
+                if data_type == DataType::Int64 {
+                    let live = (Box::new(col("flag")), Box::new(col("discarded")));
+                    for branches in [
+                        vec![dead.clone(), live.clone()],
+                        vec![live.clone(), dead.clone()],
+                    ] {
+                        let expr = Expr::Case(Case::new(None, branches, Some(Box::new(col("value")))));
+                        let expected = Expr::Case(Case::new(
+                            None,
+                            vec![live.clone()],
+                            Some(Box::new(col("value"))),
+                        ));
+                        assert_eq!(simplifier.simplify_algebraic_once(expr)?.data, expected);
+                    }
+                    let expr = Expr::Case(Case::new(
+                        Some(Box::new(col("value"))),
+                        vec![dead],
+                        Some(Box::new(col("value"))),
+                    ));
+                    assert_eq!(simplifier.simplify_algebraic_once(expr.clone())?.data, expr);
+                }
+            }
+        }
+        Ok(())
+    }
