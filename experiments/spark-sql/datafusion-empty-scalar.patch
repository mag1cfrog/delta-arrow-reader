     #[test]
+    fn scalar_subquery_nullable_field() -> Result<()> {
+        use datafusion_expr::execution_props::{ScalarSubqueryResults, SubqueryIndex};
+        use datafusion_expr::{EmptyRelation, LogicalPlan, expr_fn::scalar_subquery};
+
+        for data_type in [DataType::Int32, DataType::Decimal128(12, 3)] {
+            for nullable in [false, true] {
+                let schema = Schema::new(vec![Field::new("v", data_type.clone(), nullable)]);
+                let expr = scalar_subquery(Arc::new(LogicalPlan::EmptyRelation(
+                    EmptyRelation {
+                        produce_one_row: false,
+                        schema: Arc::new(DFSchema::try_from(schema)?),
+                    },
+                )));
+                let Expr::ScalarSubquery(subquery) = &expr else {
+                    unreachable!()
+                };
+                let index = SubqueryIndex::new(0);
+                let mut props = ExecutionProps::new();
+                props.subquery_indexes.insert(subquery.clone(), index);
+                props.subquery_results = ScalarSubqueryResults::new(1);
+                let null = ScalarValue::try_from(&data_type)?;
+                props.subquery_results.set(index, null.clone())?;
+                let physical = create_physical_expr(&expr, &DFSchema::empty(), &props)?;
+                assert!(physical.nullable(&Schema::empty())?);
+                assert_eq!(physical.data_type(&Schema::empty())?, data_type);
+                let value = physical.evaluate(&RecordBatch::new_empty(Arc::new(Schema::empty())))?;
+                assert_eq!(ScalarValue::try_from_array(&value.into_array(1)?, 0)?, null);
+            }
+        }
+        Ok(())
+    }
