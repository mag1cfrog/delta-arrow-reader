 // See tests in datafusion/core/tests/physical_optimizer
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use arrow::array::AsArray;
+    use arrow::compute::SortOptions;
+    use arrow::datatypes::Int32Type;
+    use datafusion_common::{ScalarValue, record_batch};
+    use datafusion_expr::execution_props::{ScalarSubqueryResults, SubqueryIndex};
+    use datafusion_physical_expr::expressions::col;
+    use datafusion_physical_expr::{LexOrdering, PhysicalSortExpr};
+    use datafusion_physical_plan::scalar_subquery::{
+        ScalarSubqueryExec, ScalarSubqueryLink,
+    };
+    use datafusion_physical_plan::test::TestMemoryExec;
+    use datafusion_physical_plan::{collect, displayable};
+
+    #[tokio::test]
+    async fn scalar_subquery_preserves_hidden_sort_key() -> Result<()> {
+        for (ordered, fetch) in [(true, None), (true, Some(2)), (false, None)] {
+            let batch = record_batch!(
+                ("key", Int32, vec![3, 1, 2]),
+                ("value", Int32, vec![30, 10, 20])
+            )?;
+            let mut input: Arc<dyn ExecutionPlan> = TestMemoryExec::try_new_exec(
+                &[vec![batch.clone()]],
+                batch.schema(),
+                None,
+            )?;
+            if ordered {
+                let ordering = LexOrdering::new([PhysicalSortExpr::new(
+                    col("key", &input.schema())?,
+                    SortOptions::default(),
+                )])
+                .unwrap();
+                input = Arc::new(SortExec::new(ordering, input).with_fetch(fetch));
+            }
+            let input = Arc::new(ProjectionExec::try_new(
+                vec![(col("value", &input.schema())?, "value".to_owned())],
+                input,
+            )?);
+            let results = ScalarSubqueryResults::new(2);
+            let mut subqueries = Vec::new();
+            for (i, value) in [7, 9].into_iter().enumerate() {
+                let batch = record_batch!(("s", Int32, vec![value]))?;
+                subqueries.push(ScalarSubqueryLink {
+                    plan: TestMemoryExec::try_new_exec(
+                        &[vec![batch.clone()]],
+                        batch.schema(),
+                        None,
+                    )?,
+                    index: SubqueryIndex::new(i),
+                });
+            }
+            let mut plan: Arc<dyn ExecutionPlan> =
+                Arc::new(ScalarSubqueryExec::new(input, subqueries, results.clone()));
+            let mut trace = Vec::new();
+            for rule in crate::optimizer::PhysicalOptimizer::new().rules {
+                plan = rule.optimize(plan, &ConfigOptions::default())?;
+                if matches!(rule.name(), "OutputRequirements" | "EnforceSorting") {
+                    trace.push((
+                        rule.name().to_owned(),
+                        displayable(plan.as_ref()).indent(true).to_string(),
+                    ));
+                }
+            }
+            let batches = collect(plan, Arc::new(TaskContext::default())).await?;
+            let mut actual: Vec<i32> = batches
+                .iter()
+                .flat_map(|b| {
+                    b.column(0)
+                        .as_primitive::<Int32Type>()
+                        .values()
+                        .iter()
+                        .copied()
+                })
+                .collect();
+            if !ordered {
+                // Without ORDER BY, only the values are part of the contract.
+                actual.sort_unstable();
+            }
+            let expected = match (ordered, fetch) {
+                (true, Some(2)) => vec![10, 20],
+                (true, _) => vec![10, 20, 30],
+                (false, _) => vec![10, 20, 30],
+            };
+            assert_eq!(actual, expected, "{trace:#?}");
+            for (i, value) in [7, 9].into_iter().enumerate() {
+                assert_eq!(
+                    results.get(SubqueryIndex::new(i)),
+                    Some(ScalarValue::Int32(Some(value)))
+                );
+            }
+        }
+        Ok(())
+    }
+}
