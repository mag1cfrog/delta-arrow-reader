     #[test]
+    fn constant_decimal_rounder_matches_scalar_helper() {
+        use arrow::array::{Array, Int32Array, PrimitiveArray};
+        use arrow::datatypes::ArrowNativeType;
+        use arrow::datatypes::{
+            ArrowNativeTypeOp, Decimal32Type, Decimal64Type, Decimal128Type,
+            Decimal256Type, DecimalType,
+        };
+
+        fn check<T: DecimalType>() {
+            let precision = T::MAX_PRECISION;
+            let max = T::Native::usize_as(10)
+                .pow_checked(u32::from(precision))
+                .unwrap()
+                .sub_wrapping(T::Native::ONE);
+            let values = [
+                T::Native::ZERO,
+                T::Native::usize_as(5),
+                T::Native::usize_as(15),
+                T::Native::usize_as(25),
+                max,
+            ];
+            for scale in [-2, 0, 2, precision as i8] {
+                for dp in [i32::MIN, -2, 0, 1, 2, i32::from(precision), i32::MAX] {
+                    for output_scale in
+                        [super::output_scale_for_decimal(precision, scale, dp), scale]
+                    {
+                        for places in [
+                            ColumnarValue::Scalar(ScalarValue::Int32(Some(dp))),
+                            ColumnarValue::Array(Arc::new(Int32Array::from(vec![dp]))),
+                        ] {
+                            let round = super::decimal_rounder::<T::Native>(
+                                precision,
+                                scale,
+                                output_scale,
+                                &places,
+                            );
+                            for value in values {
+                                for value in [value, value.neg_wrapping()] {
+                                    let expected = super::round_decimal_or_zero(
+                                        value,
+                                        precision,
+                                        scale,
+                                        output_scale,
+                                        dp,
+                                    );
+                                    let actual = round(value, dp);
+                                    assert_eq!(
+                                        format!("{actual:?}"),
+                                        format!("{expected:?}"),
+                                        "precision={precision}, scale={scale}, output_scale={output_scale}, dp={dp}, value={value:?}"
+                                    );
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            // Exercise all four array branches, including empty and NULL arrays.
+            for raw in [
+                vec![],
+                vec![None],
+                vec![None, Some(124), Some(125), Some(-125)],
+            ] {
+                let input = PrimitiveArray::<T>::from_iter(raw.iter().map(|v| {
+                    v.map(|v: i32| {
+                        let magnitude = T::Native::usize_as(v.unsigned_abs() as usize);
+                        if v < 0 {
+                            magnitude.neg_wrapping()
+                        } else {
+                            magnitude
+                        }
+                    })
+                }))
+                .with_precision_and_scale(precision, 2)
+                .unwrap();
+                for dp in [Some(1), None] {
+                    let expected = PrimitiveArray::<T>::from_iter(raw.iter().map(|v| {
+                        v.and_then(|v| {
+                            dp.map(|_| {
+                                let magnitude = T::Native::usize_as(
+                                    ((v.unsigned_abs() + 5) / 10) as usize,
+                                );
+                                if v < 0 {
+                                    magnitude.neg_wrapping()
+                                } else {
+                                    magnitude
+                                }
+                            })
+                        })
+                    }))
+                    .with_precision_and_scale(precision, 1)
+                    .unwrap();
+                    let actual = super::round_columnar(
+                        &ColumnarValue::Array(Arc::new(input.clone())),
+                        &ColumnarValue::Scalar(ScalarValue::Int32(dp)),
+                        raw.len(),
+                        &T::TYPE_CONSTRUCTOR(precision, 1),
+                    )
+                    .unwrap();
+                    let ColumnarValue::Array(actual) = actual else {
+                        panic!("expected array")
+                    };
+                    assert_eq!(actual.to_data(), expected.to_data());
+                }
