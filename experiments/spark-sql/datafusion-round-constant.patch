+// Prepare factors only when a scalar scale needs no final rescaling. Failed
+// preparation falls back, preserving errors only for evaluated non-NULL values.
+fn decimal_rounder<V: ArrowNativeTypeOp>(
+    precision: u8,
+    input_scale: i8,
+    output_scale: i8,
+    decimal_places: &ColumnarValue,
+) -> impl Fn(V, i32) -> Result<V, ArrowError> {
+    let cached = match decimal_places {
+        ColumnarValue::Scalar(ScalarValue::Int32(Some(dp)))
+            if *dp >= 0
+                && *dp < i32::from(input_scale)
+                && *dp == i32::from(output_scale) =>
+        {
+            V::from_usize(10)
+                .zip(V::from_usize(2))
+                .and_then(|(ten, two)| {
+                    ten.pow_checked((i32::from(input_scale) - *dp) as u32)
+                        .ok()
+                        .map(|factor| (factor, factor.div_wrapping(two)))
+                })
+        }
+        _ => None,
+    };
+    move |value, dp| match cached {
+        Some((factor, threshold)) => round_decimal_with_factor(value, factor, threshold),
+        None => round_decimal_or_zero(value, precision, input_scale, output_scale, dp),
+    }
+}
+
+fn round_decimal_with_factor<V: ArrowNativeTypeOp>(
+    value: V,
+    factor: V,
+    threshold: V,
+) -> Result<V, ArrowError> {
+    let mut quotient = value.div_wrapping(factor);
+    let remainder = value.mod_wrapping(factor);
+    if remainder >= threshold {
+        quotient = quotient.add_checked(V::ONE).map_err(|_| {
+            ArrowError::ComputeError("Overflow while rounding decimal".into())
+        })?;
+    } else if remainder <= threshold.neg_wrapping() {
+        quotient = quotient.sub_checked(V::ONE).map_err(|_| {
+            ArrowError::ComputeError("Overflow while rounding decimal".into())
+        })?;
+    }
+    Ok(quotient)
+}
