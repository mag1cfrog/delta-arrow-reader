  "findings": {
    "status": "Retain the optional native-output optimization; the original final-Decimal query cost remains unresolved.",
    "mechanism": "Consume an owned zero-offset left Float64 buffer through Arrow MutableBuffer, preserve its allocation layout and prefix length, apply the same floating addition, and union NULL bitmaps. Shared buffers, nonzero offsets and scalar inputs use the existing borrowed path.",
    "native_execution": "Derived native DOUBLE addition improves 44.500%; stored FLOAT plus integer improves 79.855%. Median page faults over 41 executions fall from 126446 to 42664 and from 84386 to 345, respectively.",
    "decimal_execution": "The full query changes -0.301%, smaller than same-binary Decimal control shifts of -0.556% and -0.967%. Page faults remain approximately 126000. This does not resolve the earlier approximately 19% full-query difference.",
    "shared_path_cost": "Ready shared DOUBLE addition has +0.817% paired elapsed time and +0.346% instructions. Its after-binary control shifts -1.100%; the timing effect is smaller than that control variation. The additional dispatch is not free.",
    "rejected_reuse": "Direct Arrow 58.4 binary_mut use did not preserve prefix-slice lengths in a unit test, and a separate executable confirmed it copies aligned try_unary cast buffers. Both facts informed the lower-level safe-buffer implementation.",
    "coverage": {
      "native_tests": 80,
      "planner_tests": 37,
      "runner_tests": 28,
      "runner_lifecycle_tests": 4,
      "array_ownership_test_combinations": 64,
      "benchmark_checks": 258,
      "existing_sql_observations": 6068,
      "focused_sql_observations": 716,
      "real_delta_comparisons": 116
    },
    "limits": [
      "Only finite non-NULL addition at batch size 8192 is timed.",
      "NULLs, slices and ownership variants have correctness coverage but no isolated performance result.",
      "Only the left buffer is considered for reuse; nonzero-offset arrays retain the borrowed path.",
      "Component timings cannot be added or subtracted to attribute full-query costs.",
      "Existing SQL disagreements and previous localized costs remain. No new Spark-compatibility agreement is claimed."
    ],
    "next_bounded_step": "Inspect allocation lifetimes through the final floating-to-Decimal conversion; native buffer reuse alone leaves its page-fault count essentially unchanged."
  },
