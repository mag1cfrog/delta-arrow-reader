+#[tokio::test]
+async fn local_projection_preserves_row_then_column_failure()
+-> std::result::Result<(), Box<dyn std::error::Error + Send + Sync>> {
+    use crate::{config::PlanConfig, physical_plan::SparkQueryPlanner, resolver::PlanResolver};
+    use datafusion::arrow::array::AsArray;
+    use datafusion::arrow::datatypes::{DataType, Decimal128Type};
+    use datafusion::execution::SessionStateBuilder;
+    use datafusion::prelude::{SessionConfig, SessionContext};
+
+    for batch_size in [1, 2, 4] {
+        let ctx = SessionContext::new_with_state(
+            SessionStateBuilder::new()
+                .with_config(
+                    SessionConfig::new()
+                        .with_batch_size(batch_size)
+                        .with_target_partitions(2),
+                )
+                .with_default_features()
+                .with_analyzer_rule(Arc::new(SparkDecimalNullPropagation))
+                .with_query_planner(Arc::new(SparkQueryPlanner))
+                .build(),
+        );
+        for rows in [
+            vec![(0, 100), (200, 0)],
+            vec![(200, 0), (0, 100)],
+            vec![(0, 0), (0, 100), (200, 0)],
+        ] {
+            let source = rows
+                .iter()
+                .map(|(x, y)| format!("(CAST({x} AS DECIMAL(4,0)),CAST({y} AS DECIMAL(4,0)))"))
+                .collect::<Vec<_>>()
+                .join(",");
+            for reverse_columns in [false, true] {
+                let columns = if reverse_columns {
+                    ["y", "x"]
+                } else {
+                    ["x", "y"]
+                };
+                let ordered: Vec<_> = rows
+                    .iter()
+                    .map(|&(x, y)| if reverse_columns { [y, x] } else { [x, y] })
+                    .collect();
+                let first = ordered
+                    .iter()
+                    .flatten()
+                    .find(|&&value| value >= 100)
+                    .unwrap();
+                for ansi in [true, false] {
+                    for cast in ["CAST", "TRY_CAST"] {
+                        let sql = format!(
+                            "SELECT {cast}({} AS DECIMAL(2,0)) AS a,{cast}({} AS DECIMAL(2,0)) AS b FROM VALUES {source} t(x,y)",
+                            columns[0], columns[1]
+                        );
+                        let ast = sail_sql_analyzer::parser::parse_one_statement(&sql)?;
+                        let spec = sail_sql_analyzer::statement::from_ast_statement(ast)?;
+                        let config = PlanConfig {
+                            ansi_mode: ansi,
+                            ..Default::default()
+                        };
+                        let named = PlanResolver::new(&ctx, Arc::new(config))
+                            .resolve_named_plan(spec)
+                            .await?;
+                        let physical = async {
+                            ctx.execute_logical_plan(named.plan)
+                                .await?
+                                .create_physical_plan()
+                                .await
+                        }
+                        .await;
+                        if ansi && cast == "CAST" {
+                            let error = physical
+                                .expect_err("local projection must fail before execution")
+                                .to_string();
+                            assert!(
+                                error.starts_with("spark_decimal_null_propagation\ncaused by\n"),
+                                "{error}"
+                            );
+                            assert!(
+                                error.contains(&format!(": {first} is too ")),
+                                "{sql}: {error}"
+                            );
+                        } else {
+                            let physical = physical?;
+                            assert!(
+                                physical
+                                    .schema()
+                                    .fields()
+                                    .iter()
+                                    .all(|f| f.data_type() == &DataType::Decimal128(2, 0))
+                            );
+                            let batches =
+                                datafusion::physical_plan::collect(physical, ctx.task_ctx())
+                                    .await?;
+                            let mut actual = Vec::new();
+                            for batch in batches {
+                                actual.extend(
+                                    batch.column(0).as_primitive::<Decimal128Type>().iter().zip(
+                                        batch.column(1).as_primitive::<Decimal128Type>().iter(),
+                                    ),
+                                );
+                            }
+                            let mut expected: Vec<_> = ordered
+                                .iter()
+                                .map(|[x, y]| {
+                                    (
+                                        (*x < 100).then_some(i128::from(*x)),
+                                        (*y < 100).then_some(i128::from(*y)),
+                                    )
+                                })
+                                .collect();
+                            actual.sort();
+                            expected.sort();
+                            assert_eq!(actual, expected, "{sql}, ANSI={ansi}");
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
