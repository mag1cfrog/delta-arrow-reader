+#[tokio::test]
+async fn spark_decimal_null_subqueries_do_not_read_delta() -> TestResult {
+    let fixture = RealParquetDeltaTable::new_default("spark-null-subqueries")?;
+    let table = DeltaTableBuilder::new(fixture.path().to_string_lossy().into_owned())
+        .with_warmup(WarmupMode::QueryPlanning)
+        .load_table()
+        .await?;
+    let ctx = context(1)?;
+    ctx.register_table(
+        "dv",
+        Arc::new(DeltaTableProvider::try_new(table, ScanOptions::default())?),
+    )?;
+    let data = fixture.path().join(fixture.data_file_path());
+    let hidden = data.with_extension("unavailable");
+    fs::rename(&data, &hidden)?;
+    for (subquery, outer, rows) in [
+        ("SELECT CAST(id AS DECIMAL(18,4)) FROM dv", "", 1),
+        (
+            "SELECT CAST(concat('bad', CAST(id AS STRING)) AS DECIMAL(18,4)) FROM dv",
+            "",
+            1,
+        ),
+        (
+            "SELECT CAST(id AS DECIMAL(18,4)) FROM dv WHERE id=o.k",
+            "FROM VALUES (1), (2) AS o(k)",
+            2,
+        ),
+    ] {
+        for expression in [
+            format!("CAST(NULL AS DECIMAL(18,4)) / ({subquery})"),
+            format!("({subquery}) / CAST(NULL AS DECIMAL(18,4))"),
+        ] {
+            let physical = plan(&ctx, &format!("SELECT {expression} AS r {outer}")).await?;
+            assert!(collect_scan_metrics(physical.as_ref()).is_empty());
+            assert_eq!(
+                physical.schema().field(0).data_type(),
+                &DataType::Decimal128(38, 20)
+            );
+            assert!(physical.schema().field(0).is_nullable());
+            let mut stream = execute_stream(physical, ctx.task_ctx())?;
+            let mut actual = 0;
+            while let Some(batch) = stream.next().await {
+                let batch = batch?;
+                assert_eq!(batch.column(0).null_count(), batch.num_rows());
+                actual += batch.num_rows();
+            }
+            assert_eq!(actual, rows);
+        }
+    }
+    let error = plan(
+        &ctx,
+        "SELECT CAST(NULL AS DECIMAL(18,4)) / (SELECT CAST('bad' AS DECIMAL(18,4)) FROM dv)",
+    )
+    .await
+    .unwrap_err()
+    .to_string();
+    assert!(
+        error.contains("Cannot cast") && error.contains("DECIMAL(18,4)"),
+        "{error}"
+    );
+    let live = plan(&ctx, "SELECT id FROM dv").await?;
+    assert_idle(live.as_ref());
+    fs::rename(&hidden, &data)?;
+    assert_eq!(read_ids(&ctx, live).await?, vec![1, 2, 3]);
+    Ok(())
 }
 
