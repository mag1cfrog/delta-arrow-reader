+#[cfg(test)]
+#[tokio::test]
+async fn decimal_arithmetic_keeps_exact_intermediates_and_spark_result_types() -> PlanResult<()> {
+    use crate::config::PlanConfig;
+    use crate::resolver::PlanResolver;
+    use datafusion::arrow::array::{Array, AsArray};
+    use datafusion::arrow::datatypes::Decimal128Type;
+    use datafusion::prelude::SessionContext;
+    for ansi in [true, false] {
+        let ctx = SessionContext::new();
+        let mut config = PlanConfig::default();
+        config.ansi_mode = ansi;
+        let resolver = PlanResolver::new(&ctx, Arc::new(config));
+        for (a, b, op, precision, scale, expected) in [
+            ("CAST(0.123456789012345675 AS DECIMAL(38,18))", "1", "+", 38, 17, "112345678901234568"),
+            ("CAST(0.123456789012345675 AS DECIMAL(38,18))", "1", "-", 38, 17, "-87654321098765433"),
+            ("CAST(0.123456789012345675 AS DECIMAL(38,18))", "1", "*", 38, 7, "1234568"),
+            ("CAST(0.99999999999999999999999999999999999999 AS DECIMAL(38,38))", "CAST(0.99999999999999999999999999999999999999 AS DECIMAL(38,38))", "*", 38, 37, "10000000000000000000000000000000000000"),
+            ("CAST('99999999999999999999999999999999999999' AS DECIMAL(38,0))", "CAST(0.12345678901234567890123456789012345678 AS DECIMAL(38,38))", "%", 38, 38, "8271507798827209828883258328793215726"),
+            ("CAST(2.25 AS DECIMAL(8,2))", "CAST(1 AS DECIMAL(1,0))", "%", 3, 2, "25"),
+        ] {
+            let sql = format!("SELECT a {op} b AS r FROM VALUES ({a},{b}),(NULL,NULL) t(a,b)");
+            let ast = sail_sql_analyzer::parser::parse_one_statement(&sql)?;
+            let spec = sail_sql_analyzer::statement::from_ast_statement(ast)?;
+            let named = resolver.resolve_named_plan(spec).await?;
+            assert_eq!(named.plan.schema().field(0).data_type(), &DataType::Decimal128(precision, scale), "{sql}");
+            let batches = ctx.execute_logical_plan(named.plan).await?.collect().await?;
+            let values = batches[0].column(0).as_primitive::<Decimal128Type>();
+            assert_eq!(values.data_type(), &DataType::Decimal128(precision, scale));
+            assert_eq!(values.value(0), expected.parse::<i128>().unwrap(), "{sql}");
+            assert!(values.is_null(1), "{sql}");
+        }
+        for op in ["+", "-", "*"] {
+            let b = if op == "-" { "-2" } else { "2" };
+            let sql = format!("SELECT a {op} b AS r FROM VALUES (CAST('99999999999999999999999999999999999999' AS DECIMAL(38,0)),{b}),(NULL,NULL) t(a,b)");
+            let ast = sail_sql_analyzer::parser::parse_one_statement(&sql)?;
+            let spec = sail_sql_analyzer::statement::from_ast_statement(ast)?;
+            let named = resolver.resolve_named_plan(spec).await?;
+            let result = ctx.execute_logical_plan(named.plan).await?.collect().await;
+            if ansi {
+                assert!(result.is_err(), "{sql}");
+            } else {
+                let batches = result?;
+                assert_eq!(batches[0].column(0).data_type(), &DataType::Decimal128(38, 0));
+                assert_eq!(batches[0].column(0).null_count(), 2);
+            }
+        }
+    }
+    Ok(())
+}
