{
  "slice": "Test native task-context reuse as an allocation-history intervention",
  "base_commit": "99161a8",
  "created_utc": "2026-09-19T14:19:33.845516+00:00",
  "decision": {
    "finding": "Fresh contexts diverge at construction 58 in both seed groups. Reused contexts have matching addresses for all 295 positions in seed 0 and first diverge at 219 in seed 4. Every seed retains identical complete IN hash fingerprints across context modes.",
    "scope": "The finite comparison supports context allocation/lifetime as a contributor to address variability. Reuse does not eliminate all variation, identify a unique root cause or establish a performance effect.",
    "adopt_float_type_patch": false,
    "accepted_runtime_changed": false,
    "performance_effect_estimated": false
  },
  "summary": {
    "groups": 4,
    "processes": 16,
    "constructed_table_traces": 4720,
    "resolver_field_order_traces": 4720,
    "field_release_events": 14160,
    "prepared_plan_executions": 4176,
    "exact_correctness_captures": 372,
    "collection_query_captures": 32,
    "smoke_processes": 8,
    "smoke_executions": 24,
    "invalid_settings_rejected": 2,
    "new_builds": 1,
    "failed_or_discarded_collection_groups": 0,
    "new_spark_corpus_runs": 0,
    "global_settings_changed": false
  },
  "method": {
    "base_commit": "99161a8",
    "question": "Does cloning native task contexts for validation, warmups and execution contribute to later IN-table allocation variability?",
    "source_finding": "SessionContext::task_ctx creates a TaskContext from SessionState, cloning four std HashMap function registries. The current benchmark invokes it for each execution.",
    "intervention": "Only the benchmark changes. Both modes create and retain one native TaskContext before the generic-IN loop. Fresh mode still creates a new native context for each execution; reuse mode clones the Arc to the held context. Registry contents and query plans remain unchanged. Other benchmark modes keep the original consume wrapper.",
    "design": "One release executable selected by equal-length fresh/reuse child settings. Retain sorted resolver release, native allocator settings, fixed addresses, 32 warmups and 261 prepared plans. Four processes per context mode for each native seed index 0 and 4; mode order reversed for the second seed.",
    "analysis": "Require matching hash fingerprints across modes before interpreting address differences. Compare every construction and address mismatch position within groups. Timings and counters remain incidental, with no performance effect estimated.",
    "validation": "All 186 existing result/plan captures per context mode, eight smoke processes, missing/invalid context-mode rejection and all collection-query checks. These are repeated cases, not new Spark coverage.",
    "stopping_rule": "One diagnostic Rust build and exactly four groups. Preserve all captures and failures. Restore and hash-check all shared files in finally. No unrelated work overlaps collection.",
    "limits": [
      "Both modes retain an extra TaskContext, so fresh mode is not byte-identical to the preceding benchmark.",
      "The selected query has no changing session configuration; context reuse is a diagnostic here, not a blanket production recommendation.",
      "Planning can create additional TaskContext or SessionState clones internally, which this intervention does not remove.",
      "The optional type-inference candidate remains unadopted and its earlier release mean interval remains unresolved."
    ]
  },
