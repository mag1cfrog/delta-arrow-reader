+    #[test]
+    fn grouping_id_packing_boundaries() -> Result<()> {
+        let mut ends = vec![false; 64];
+        ends[0] = true;
+        ends[63] = true;
+        for (group, ordinal, max_ordinal, expected, data_type) in [
+            (vec![], 0, 0, 0, DataType::UInt8),
+            (vec![], 2, 2, 2, DataType::UInt8),
+            (vec![true; 8], 0, 0, 255, DataType::UInt8),
+            (vec![true; 8], 1, 1, 511, DataType::UInt16),
+            (vec![true; 16], 1, 1, 131071, DataType::UInt32),
+            (vec![true; 32], 1, 1, 8589934591, DataType::UInt64),
+            (vec![true; 63], 1, 1, u64::MAX, DataType::UInt64),
+            (vec![false; 64], 0, 0, 0, DataType::UInt64),
+            (vec![true; 64], 0, 0, u64::MAX, DataType::UInt64),
+            (ends, 0, 0, (1_u64 << 63) | 1, DataType::UInt64),
+        ] {
+            for rows in [0, 1, 2] {
+                let values = group_id_array(&group, ordinal, max_ordinal, rows)?;
+                assert_eq!(values.data_type(), &data_type);
+                assert_eq!(values.null_count(), 0);
+                let values = arrow::compute::cast(&values, &DataType::UInt64)?;
+                let values = values.as_any().downcast_ref::<UInt64Array>().unwrap();
+                assert_eq!(values.values().as_ref(), vec![expected; rows].as_slice());
+            }
+        }
+        assert!(group_id_array(&[false; 65], 0, 0, 1).is_err());
+        assert!(group_id_array(&[false; 64], 1, 1, 1).is_err());
+        assert!(group_id_array(&[false; 63], 2, 2, 1).is_err());
+        Ok(())
+    }
 
