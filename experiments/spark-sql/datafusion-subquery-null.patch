+/// Returns false if a scalar subquery prevents evaluation at optimization time.
 pub fn evaluates_to_null<'a>(
     predicate: Expr,
     null_columns: impl IntoIterator<Item = &'a Column>,
 ) -> Result<bool> {
+    // Scalar subqueries need runtime context that this evaluator does not have.
+    // Keep the caller's compensation expression instead of trying to execute it.
+    if predicate.contains_scalar_subquery() {
+        return Ok(false);
+    }
+
     if matches!(predicate, Expr::Column(_)) {
         return Ok(true);
     }
