+/// Cast Decimal128 to Float64 with one rounding of the scaled value.
+pub(crate) fn cast_decimal128_to_float64(
+    array: &dyn Array,
+    scale: i8,
+) -> Result<ArrayRef, ArrowError> {
+    let array = array.as_primitive::<Decimal128Type>();
+    if scale == 0 {
+        return Ok(Arc::new(array.unary::<_, Float64Type>(|v| v as f64)));
+    }
+    // Powers of ten through 10^22 are exactly representable in Float64.
+    // Dividing or multiplying an exact coefficient then rounds only once.
+    let array = if scale.unsigned_abs() <= 22 {
+        let factor = 10_f64.powi(scale.unsigned_abs() as i32);
+        let divisor = if (1..=21).contains(&scale) {
+            10_u128.pow(scale as u32)
+        } else {
+            0
+        };
+        let divisor_bits = 128 - divisor.leading_zeros();
+        array.unary::<_, Float64Type>(|v| {
+            let value = if (-(1_i128 << 53)..=(1_i128 << 53)).contains(&v) {
+                (v as i64) as f64
+            } else if v.unsigned_abs().leading_zeros() + v.unsigned_abs().trailing_zeros() >= 75 {
+                // Larger integers are exact when only their top 53 bits are nonzero.
+                v as f64
+            } else if divisor != 0 {
+                return decimal128_ratio_to_float64(v, divisor, divisor_bits);
+            } else {
+                return parse_decimal128_as_float64(v, scale);
+            };
+            if scale > 0 {
+                value / factor
+            } else {
+                value * factor
+            }
+        })
+    } else {
+        array.unary::<_, Float64Type>(|v| parse_decimal128_as_float64(v, scale))
+    };
+    Ok(Arc::new(array))
+}
+
+#[inline(never)]
+fn decimal128_ratio_to_float64(value: i128, divisor: u128, divisor_bits: u32) -> f64 {
+    let magnitude = value.unsigned_abs();
+    // Keep 55 or 56 quotient bits: 53 significand bits, a round bit and a
+    // sticky bit. For scales 1..=21 the shifted numerator fits in u128.
+    let shift = 128 - magnitude.leading_zeros() as i32 - divisor_bits as i32 - 55;
+    let (numerator, denominator) = if shift >= 0 {
+        (magnitude, divisor << shift)
+    } else {
+        (magnitude << -shift, divisor)
+    };
+    let quotient = numerator / denominator;
+    let remainder = numerator % denominator;
+    let rounded = ((quotient as i64) | (remainder != 0) as i64) as f64;
+    // All Decimal128 ratios here are normal Float64 values. Scaling by an
+    // exact power of two preserves the integer conversion's rounding.
+    let result = rounded * f64::from_bits(((1023 + shift) as u64) << 52);
+    if value < 0 { -result } else { result }
+}
+
+#[inline(never)]
+fn parse_decimal128_as_float64(value: i128, scale: i8) -> f64 {
+    // i128 plus an exponent fits in 64 bytes, including scale = i8::MIN.
+    let mut buffer = [0_u8; 64];
+    let mut len = lexical_core::write(value, &mut buffer).len();
+    buffer[len] = b'e';
+    len += 1;
+    len += lexical_core::write(-(scale as i16), &mut buffer[len..]).len();
+    lexical_core::parse(&buffer[..len]).expect("valid decimal coefficient and exponent")
+}
