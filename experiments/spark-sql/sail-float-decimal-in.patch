+pub(crate) fn spark_in_list(
+    value: expr::Expr,
+    list: Vec<expr::Expr>,
+    negated: bool,
+    schema: &DFSchemaRef,
+) -> PlanResult<expr::Expr> {
+    let mut input = expr::InList::new(Box::new(value), list, negated);
+    let (mut decimal, mut floating) = (false, false);
+    for value in std::iter::once(input.expr.as_ref()).chain(&input.list) {
+        let data_type = value.get_type(schema)?;
+        // Leave string promotion and non-numeric coercion to the existing path.
+        if !data_type.is_numeric() && data_type != DataType::Null {
+            return Ok(expr::Expr::InList(input));
+        }
+        decimal |= data_type.is_decimal();
+        floating |= data_type.is_floating();
+    }
+    if decimal && floating {
+        // Spark chooses one DOUBLE type for the entire numeric list. Keep
+        // native IN evaluation and normalize only original floating operands.
+        let convert = |value: expr::Expr| -> PlanResult<expr::Expr> {
+            Ok(if value.get_type(schema)?.is_floating() {
+                ScalarUDF::from(SparkComparisonFloat).call(vec![value])
+            } else {
+                cast(value, DataType::Float64)
+            })
+        };
+        input.expr = Box::new(convert(*input.expr)?);
+        input.list = input
+            .list
+            .into_iter()
+            .map(convert)
+            .collect::<PlanResult<_>>()?;
+    }
+    Ok(expr::Expr::InList(input))
 }
 
