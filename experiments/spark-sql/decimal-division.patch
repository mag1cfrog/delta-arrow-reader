+// Decimal division with numeric/NULL peers; Spark's default decimal settings are used.
+const SPARK_MINIMUM_ADJUSTED_SCALE: i32 = 6;
+const SPARK_MAX_SCALE: i32 = 38;
+const ARROW_DIV_SCALE_INCREMENT: i8 = 4;
