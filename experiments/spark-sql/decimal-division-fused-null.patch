+    fn simplify(
+        &self,
+        args: Vec<Expr>,
+        _info: &datafusion_expr::simplify::SimplifyContext,
+    ) -> datafusion_common::Result<datafusion_expr::simplify::ExprSimplifyResult> {
+        use datafusion_expr::simplify::ExprSimplifyResult;
+        // SQL operands are already Decimal-typed. The decorrelator substitutes
+        // untyped NULL for empty aggregates. Fold only that sentinel: folding
+        // typed SQL NULLs can hide ANSI errors in the other operand's subquery.
+        if args.iter().any(|arg| matches!(arg, Expr::Literal(ScalarValue::Null, _))) {
+            return Ok(ExprSimplifyResult::Simplified(lit(ScalarValue::Decimal128(
+                None, self.precision, self.scale,
+            ))));
+        }
+        Ok(ExprSimplifyResult::Original(args))
+    }
