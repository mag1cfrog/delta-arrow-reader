{
  "slice": "Test whether allocation divergence follows warmup history or a fixed retained-plan count",
  "base_commit": "8eda9a9",
  "created_utc": "2026-09-19T13:58:48.826089+00:00",
  "decision": {
    "finding": "With 32 warmups, both seeds first diverge at prepared-plan index 253. With 28 or 36 warmups, first differences occur at indices 78, 122, 213 and 90. Each group still has one complete hash-fingerprint sequence.",
    "scope": "The preceding boundary is specific to the 32-warmup history. Neither a universal total-construction threshold nor a universal retained-plan threshold explains all observations. Allocation history remains a hypothesis to test directly; no performance effect is estimated.",
    "adopt_float_type_patch": false,
    "accepted_runtime_changed": false,
    "performance_effect_estimated": false
  },
  "summary": {
    "groups": 6,
    "processes": 24,
    "constructed_table_traces": 7080,
