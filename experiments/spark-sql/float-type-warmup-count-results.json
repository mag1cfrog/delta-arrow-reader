  "method": {
    "base_commit": "8eda9a9",
    "question": "Does the address boundary follow total constructed queries or the number of retained plans when warmup count changes?",
    "binary": "Reuse the exact V executable; fixed addresses, sorted field release and 261 prepared plans.",
    "design": "Two previously used native shared seed indices, 0 and 4. Three warmup counts, 28, 32 and 36, all two characters. Four processes per group; reverse warmup-count order for the second seed. Existing phase barriers and execution orders remain.",
    "analysis": "Record all construction and prepared-plan mismatch positions within each group. Compare both indices of the first divergence across warmup counts. Hash fingerprints must match within groups; cross-warmup fingerprints are not required to match because the call history changes. No timing comparison.",
    "correctness": "Reuse the identical binary's 372 prior validated captures. Smoke-test the unchanged driver in both phase orders before collection; verify every selected query in both ANSI modes.",
    "stopping_rule": "Exactly six groups and 24 processes, preserving every trace and failure. No outcome-based group addition, input replacement or removal. No overlapping work during collection.",
    "limits": [
      "Warmups execute and release plans whereas preparation retains them, so the intervention changes allocator history; it cannot by itself identify a particular allocation.",
      "The diagnostic does not justify reducing warmups or samples in performance acceptance tests.",
      "The optional type-inference patch stays unadopted; previous timing evidence remains unchanged."
    ]
  },
