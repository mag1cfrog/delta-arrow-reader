+// Prepare only wide Decimal arrays: narrow types retain their original helper.
+// Failed preparation falls back so NULL/empty arrays keep deferred errors.
+fn decimal256_rounder(
+    precision: u8,
+    input_scale: i8,
+    output_scale: i8,
+    decimal_places: &ColumnarValue,
+) -> impl Fn(i256, i32) -> Result<i256, ArrowError> {
+    let cached = match decimal_places {
+        ColumnarValue::Scalar(ScalarValue::Int32(Some(dp)))
+            if *dp >= 0
+                && *dp < i32::from(input_scale)
+                && *dp == i32::from(output_scale) =>
+        {
+            i256::from_i128(10)
+                .pow_checked((i32::from(input_scale) - *dp) as u32)
+                .ok()
+                .map(|factor| (factor, factor.div_wrapping(i256::from_i128(2))))
+        }
+        _ => None,
+    };
+    move |value, dp| match cached {
+        Some((factor, threshold)) => {
+            // Same HALF_UP arithmetic as round_decimal; keep that helper unchanged
+            // for narrow types and scalar calls.
+            let mut quotient = value.div_wrapping(factor);
+            let remainder = value.mod_wrapping(factor);
+            if remainder >= threshold {
+                quotient = quotient.add_checked(i256::ONE).map_err(|_| {
+                    ArrowError::ComputeError("Overflow while rounding decimal".into())
+                })?;
+            } else if remainder <= threshold.neg_wrapping() {
+                quotient = quotient.sub_checked(i256::ONE).map_err(|_| {
+                    ArrowError::ComputeError("Overflow while rounding decimal".into())
+                })?;
+            }
+            Ok(quotient)
+        }
+        None => round_decimal_or_zero(value, precision, input_scale, output_scale, dp),
+    }
+}
