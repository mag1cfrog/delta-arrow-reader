+#[cfg(test)]
+#[test]
+fn in_value_null_check_reads_projected_output() -> datafusion_common::Result<()> {
+    use crate::{
+        OptimizerContext, Optimizer, simplify_expressions::SimplifyExpressions,
+        decorrelate_predicate_subquery::DecorrelatePredicateSubquery,
+    };
+    use arrow::datatypes::{DataType, Field, Schema};
+    use datafusion_common::{
+        Column,
+        tree_node::{TreeNode, TreeNodeRecursion},
+    };
+    use datafusion_expr::{
+        Expr, LogicalPlan, LogicalPlanBuilder, builder::table_source, col, in_subquery, lit,
+        not_in_subquery,
+    };
+    use std::sync::Arc;
+
+    for grouped in [false, true] {
+        for nested_alias in [false, true] {
+            for relation_alias in [false, true] {
+                for negated in [false, true] {
+                    let mut input = LogicalPlanBuilder::scan(
+                        "t",
+                        table_source(&Schema::new(vec![Field::new(
+                            "a",
+                            DataType::Int64,
+                            true,
+                        )])),
+                        None,
+                    )?
+                    .build()?;
+                    if grouped {
+                        input = LogicalPlanBuilder::from(input)
+                            .aggregate(vec![col("t.a") + lit(1_i64)], Vec::<Expr>::new())?
+                            .build()?;
+                    }
+                    let value = Expr::Column(Column::from(input.schema().qualified_field(0)));
+                    let value = if nested_alias {
+                        value.alias("inner")
+                    } else {
+                        value
+                    };
+                    let mut subquery = LogicalPlanBuilder::from(input)
+                        .project(vec![value.alias("v")])?
+                        .sort(vec![col("v").sort(true, true)])?
+                        .limit(0, Some(1))?
+                        .build()?;
+                    if relation_alias {
+                        subquery = LogicalPlanBuilder::from(subquery)
+                            .alias("selected")?
+                            .build()?;
+                    }
+                    let subquery = Arc::new(subquery);
+                    let predicate = if negated {
+                        not_in_subquery(lit(7_i64), subquery)
+                    } else {
+                        in_subquery(lit(7_i64), subquery)
+                    };
+                    let plan = LogicalPlanBuilder::empty(true)
+                        .project(vec![predicate.alias("r")])?
+                        .build()?;
+                    let rewritten = Optimizer::with_rules(vec![
+                        Arc::new(DecorrelatePredicateSubquery::new()),
+                        Arc::new(SimplifyExpressions::new()),
+                    ]).optimize(plan, &OptimizerContext::new(), |_, _| {})?;
+                    assert_eq!(rewritten.schema().field(0).name(), "r");
+                    assert_eq!(rewritten.schema().field(0).data_type(), &DataType::Boolean);
+                    assert!(rewritten.schema().field(0).is_nullable());
+                    let mut null_checks = 0;
+                    rewritten.apply(|node| {
+                        if let LogicalPlan::Filter(filter) = node
+                            && let Expr::IsNull(value) = &filter.predicate
+                        {
+                            let Expr::Column(column) = value.as_ref() else {
+                                panic!("NULL check must read an output column: {value}");
+                            };
+                            assert!(filter.input.schema().index_of_column(column).is_ok());
+                            null_checks += 1;
+                        }
+                        Ok(TreeNodeRecursion::Continue)
+                    })?;
+                    assert_eq!(null_checks, 1);
+                }
+            }
+        }
+    }
+    Ok(())
+}
