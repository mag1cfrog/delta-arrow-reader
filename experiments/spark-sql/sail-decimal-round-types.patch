+fn spark_decimal_round(input: ScalarFunctionInput) -> PlanResult<Expr> {
+    let ScalarFunctionInput {
+        mut arguments,
+        function_context,
+    } = input;
+    if !(1..=2).contains(&arguments.len()) {
+        return Ok(expr_fn::round(arguments));
+    }
+    let DataType::Decimal128(precision, scale) = arguments[0].get_type(function_context.schema)?
+    else {
+        return Ok(expr_fn::round(arguments));
+    };
+    let target = arguments.get(1).cloned().unwrap_or_else(|| lit(0_i32));
+    let target_type = target.get_type(function_context.schema)?;
+    // Leave other coercions on the existing ROUND path.
+    if !target_type.is_integer() && !target_type.is_null() {
+        return Ok(expr_fn::round(arguments));
+    }
+    if target.is_volatile() {
+        return Err(PlanError::invalid("ROUND scale must be a constant integer"));
+    }
+    let target = match target {
+        Expr::Literal(value, _) => value,
+        expr => {
+            let context = SimplifyContextBuilder::default()
+                .with_schema(function_context.schema.clone())
+                .build();
+            let coerced = ExprSimplifier::new(context).coerce(expr, function_context.schema)?;
+            LiteralEvaluator::new().evaluate(&coerced).map_err(|e| {
+                PlanError::invalid(format!("ROUND scale must be a constant integer: {e}"))
+            })?
+        }
+    };
+    let target = if target.is_null() {
+        None
+    } else {
+        Some(LiteralValue(&target).try_to_i32()?)
+    };
+    let udf = ScalarUDF::from(SparkDecimalRound::new(
+        precision,
+        scale,
+        target.unwrap_or(0),
+    ));
+    Ok(udf.call(vec![arguments.remove(0), lit(ScalarValue::Int32(target))]))
+}
