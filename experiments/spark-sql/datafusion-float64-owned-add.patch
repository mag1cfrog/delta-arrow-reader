+/// Reuse an owned floating intermediate before falling back to borrowed addition.
+fn apply_float64_add(lhs: ColumnarValue, rhs: &ColumnarValue) -> Result<ColumnarValue> {
+    use arrow::buffer::NullBuffer;
+    use arrow::compute::kernels::numeric::add;
+
+    let lhs = match (lhs, rhs) {
+        (ColumnarValue::Array(left), ColumnarValue::Array(right))
+            if Arc::strong_count(&left) == 1
+                && left.len() == right.len()
+                && left
+                    .as_primitive::<Float64Type>()
+                    .values()
+                    .inner()
+                    .ptr_offset()
+                    == 0 =>
+        {
+            let values = left.as_primitive::<Float64Type>().clone();
+            drop(left);
+            let (_, values, nulls) = values.into_parts();
+            // Arrow 58's binary_mut converts aligned cast buffers to Vec, copying them.
+            // Retain the allocation layout and explicitly preserve prefix-slice length.
+            match values.into_inner().into_mutable() {
+                Ok(mut values) => {
+                    let right = right.as_primitive::<Float64Type>();
+                    values.truncate(right.len() * size_of::<f64>());
+                    values
+                        .typed_data_mut::<f64>()
+                        .iter_mut()
+                        .zip(right.values())
+                        .for_each(|(left, right)| *left += *right);
+                    let nulls = NullBuffer::union(nulls.as_ref(), right.nulls());
+                    return Ok(ColumnarValue::Array(Arc::new(Float64Array::new(
+                        values.into(),
+                        nulls,
+                    ))));
+                }
+                Err(values) => {
+                    ColumnarValue::Array(Arc::new(Float64Array::new(values.into(), nulls)))
+                }
+            }
+        }
+        // ponytail: nonzero offsets and right-buffer reuse stay on borrowed addition.
+        (lhs, _) => lhs,
+    };
+    apply(&lhs, rhs, add)
 }
 
