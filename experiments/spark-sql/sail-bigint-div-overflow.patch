+                                .iter()
+                        })
+                        .collect::<Vec<_>>();
+                    assert_eq!(values, vec![Some(i64::MIN), Some(i64::MAX), None, Some(3)]);
+                    assert_eq!(
+                        ctx.state().config_options().execution.enable_ansi_mode,
+                        host_ansi
+                    );
+                }
+            }
