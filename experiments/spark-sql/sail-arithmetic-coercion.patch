+// Reuse division's Decimal/floating and integer-literal coercion rules.
+// ANSI FLOAT/integer pairs also use DOUBLE. Literal casts fold before execution.
+fn coerce_spark_arithmetic_operands(
+    mut left: Expr,
+    mut right: Expr,
+    left_type: &DataType,
+    right_type: &DataType,
+    ansi_mode: bool,
+) -> (Expr, Expr) {
+    if is_float_decimal_pair(left_type, right_type)
+        || (ansi_mode
+            && ((left_type == &DataType::Float32 && right_type.is_integer())
+                || (right_type == &DataType::Float32 && left_type.is_integer())))
+    {
+        return (cast(left, DataType::Float64), cast(right, DataType::Float64));
+    }
+    if let Some(target) = spark_decimal_literal_datatype(&left, right_type, true) {
+        left = cast(left, target);
+    }
+    if let Some(target) = spark_decimal_literal_datatype(&right, left_type, true) {
+        right = cast(right, target);
+    }
+    (left, right)
 }

