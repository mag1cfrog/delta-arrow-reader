+pub(crate) fn is_integer_divide(expr: &Expr, schema: &DFSchemaRef) -> bool {
+    match expr {
+        Expr::ScalarFunction(f) => f.func.inner().is::<SparkSmallIntDivide>(),
+        Expr::BinaryExpr(binary) if binary.op == Operator::Divide => {
+            [&binary.left, &binary.right]
+                .iter()
+                .all(|arg| arg.get_type(schema).is_ok_and(|t| t.is_signed_integer()))
+        }
+        _ => false,
+    }
 }
 
