+// ponytail: only direct DIV outputs; general folding needs Spark's NULL and
+// conditional-expression rules, not eager physical evaluation of the parent.
+fn integer_candidate(expr: &Expr, schema: &DFSchemaRef) -> Result<bool> {
+    match expr {
+        Expr::Alias(alias) => integer_candidate(&alias.expr, schema),
+        Expr::Cast(cast) => integer_candidate(&cast.expr, schema),
+        _ => Ok(is_integer_divide(expr, schema) && row_expression(expr, false)?),
+    }
+}
