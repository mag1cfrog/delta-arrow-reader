+// Spark evaluates the divisor first when converting local VALUES. Restrict
+// the added check to strict string-column casts, including integer widening.
+// Non-ANSI DIV lowers its divisor through NULLIF and does not match this shape.
+fn column_cast(expr: &Expr, schema: &DFSchemaRef) -> bool {
+    match expr {
+        Expr::Cast(cast) if cast.field.data_type().is_signed_integer() => {
+            match cast.expr.as_ref() {
+                Expr::Column(_) => cast.expr.get_type(schema).is_ok_and(|t| t.is_string()),
+                expr => column_cast(expr, schema),
+            }
+        }
+        _ => false,
     }
 }
 
