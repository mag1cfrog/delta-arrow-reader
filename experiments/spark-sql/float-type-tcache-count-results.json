{
  "slice": "Test whether disabling per-thread allocator caching removes address variability",
  "base_commit": "392ff45",
  "created_utc": "2026-09-19T14:05:08.952713+00:00",
  "decision": {
    "finding": "All eight processes per seed share the same IN hash fingerprints across allocator modes. With caching disabled, each seed has four address sequences, differing at every position after initial validation. Explicit count 7 has two sequences for seed 0 and one for seed 4.",
    "scope": "Allocator-cache removal does not stabilize addresses. It exposes earlier variability and is rejected as a stabilization method; it does not identify a unique source of variation or a timing effect.",
    "adopt_float_type_patch": false,
    "accepted_runtime_changed": false,
    "performance_effect_estimated": false
  },
  "summary": {
    "groups": 4,
    "processes": 16,
    "constructed_table_traces": 4720,
    "resolver_field_order_traces": 4720,
    "field_release_events": 14160,
    "prepared_plan_executions": 4176,
    "reused_exact_correctness_captures": 372,
    "new_full_suite_captures": 0,
    "collection_query_captures": 32,
    "smoke_processes": 8,
    "smoke_executions": 24,
    "new_rust_builds": 0,
    "new_c_probe_builds": 1,
    "allocator_probe_processes": 3,
    "failed_or_discarded_collection_groups": 0,
    "new_spark_corpus_runs": 0,
    "global_settings_changed": false
  },
  "method": {
    "base_commit": "392ff45",
    "question": "Does disabling glibc per-thread free-chunk caching eliminate the remaining same-executable IN-table address variability?",
    "binary": "Exact V Rust executable, fixed addresses, sorted field release, 32 warmups and 261 prepared plans.",
    "design": "Two native seed indices, 0 and 4; one four-process group each for tcache_count=7 and tcache_count=0. Equal-length child-only GLIBC_TUNABLES settings; reverse allocator-mode order for the second seed.",
    "validation": "Verify documented settings with loader --list-tunables and a small allocation-reuse probe, retaining unconfigured and explicit 0/7 outputs. Run eight short benchmark smoke processes covering both settings and phase orders. Reuse the unchanged binary's prior 372 captures; each collection process validates its selected query in both ANSI modes.",
    "analysis": "Compare complete hash fingerprints across modes before interpreting allocation traces. Compare all address mismatch positions within each four-process group. All counters and timings are retained but no performance effect is estimated.",
    "stopping_rule": "Exactly four groups, 16 processes, one fixed protocol. Preserve every trace and failure. Do not add runs or change inputs based on results. No unrelated work overlaps collection.",
    "documentation": "https://sourceware.org/glibc/manual/2.42/html_node/Memory-Allocation-Tunables.html",
    "limits": [
      "Disabling a cache changes allocator behavior and may slow real workloads. It is only a diagnostic intervention, not a production recommendation.",
      "This diagnostic can show sensitivity to allocator reuse, but not which allocation or Rust code path is responsible.",
      "No candidate adoption, new Spark coverage, global setting change or timing claim."
    ]
  },
