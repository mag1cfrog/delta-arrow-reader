+// Bit checks run before timing. Each timed sample still uses consume(), so
+// neither reference arithmetic nor a result cast enters the measured phase.
+async fn validate_native_arithmetic(
+    ctx: &SessionContext,
+    plan: Arc<dyn ExecutionPlan>,
+    case: &str,
+    ansi: bool,
+) -> Result<(usize, usize, i128)> {
+    let case = case.strip_prefix("arithmetic_stage_").ok_or("unknown native case")?;
+    let f32_output = matches!(case, "derived_f32" | "cast_i64_f32" | "stored_f32" | "ready_f32" | "read_f32")
+        || (!ansi && matches!(case, "derived_f64" | "stored_f64"));
+    let expected_type = if f32_output { DataType::Float32 } else { DataType::Float64 };
+    if plan.schema().fields().len() != 1 || plan.schema().field(0).data_type() != &expected_type {
+        return Err(format!("unexpected native schema: {:?}", plan.schema()).into());
+    }
+    let mut stream = execute_stream(plan, ctx.task_ctx())?;
+    let (mut rows, mut sum) = (0, 0_i128);
+    while let Some(batch) = stream.next().await {
+        let batch = batch?;
+        let values = batch.column(0);
+        if values.null_count() != 0 { return Err("unexpected native NULL".into()); }
+        for i in 0..batch.num_rows() {
+            if rows >= ROWS { return Err("too many native rows".into()); }
+            let id = subquery_input_id(rows);
+            let key = (id % 512) as f64;
+            let stored64 = (id % 97 + 2) as f64 / 100.0 + 0.125;
+            let stored32 = f64::from(stored64 as f32);
+            let expected = match case {
+                "derived_f32" | "derived_f64" | "explicit_f64" => key + key,
+                "cast_i64_f32" | "cast_i64_f64" | "cast_derived_f64" => key,
+                "stored_f32" | "stored_f64" => stored32 + key,
+                "cast_stored_f64" | "read_f32" => stored32,
+                "ready_f32" => stored32 + stored32,
+                "ready_f64" => stored64 + stored64,
+                _ => return Err(format!("unknown native case: {case}").into()),
+            };
+            let (actual, expected) = if f32_output {
+                (u64::from(values.as_any().downcast_ref::<Float32Array>().unwrap().value(i).to_bits()), u64::from((expected as f32).to_bits()))
+            } else {
+                (values.as_any().downcast_ref::<Float64Array>().unwrap().value(i).to_bits(), expected.to_bits())
+            };
+            if actual != expected { return Err(format!("row {rows}: expected bits {expected:x}, got {actual:x}").into()); }
+            sum += i128::from(actual);
+            rows += 1;
+        }
+    }
+    if rows != ROWS { return Err(format!("expected {ROWS} native rows, got {rows}").into()); }
+    Ok((rows, 0, sum))
 }

