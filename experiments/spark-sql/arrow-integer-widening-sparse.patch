+
+// Called only for lossless integer widening with more than half null slots.
+// Keep sparse-buffer setup out of the dense path.
+#[inline(never)]
+fn cast_numeric_sparse<FROM, TO>(from: &PrimitiveArray<FROM>) -> PrimitiveArray<TO>
+where
+    FROM: ArrowPrimitiveType,
+    TO: ArrowPrimitiveType,
+    FROM::Native: NumCast,
+    TO::Native: NumCast,
+{
+    let input: &[FROM::Native] = from.values();
+    let nulls = from.nulls().unwrap().clone();
+    let mut values = vec![TO::Native::default(); input.len()];
+    nulls
+        .try_for_each_valid_idx(|index| {
+            // SAFETY: valid indices are bounded by nulls.len(), which equals
+            // input.len() and values.len() for this primitive array.
+            unsafe {
+                *values.get_unchecked_mut(index) =
+                    num_cast::<FROM::Native, TO::Native>(*input.get_unchecked(index))
+                        .expect("lossless integer widening");
+            }
+            Ok::<_, std::convert::Infallible>(())
+        })
+        .unwrap();
+    PrimitiveArray::new(values.into(), Some(nulls))
 }
 
