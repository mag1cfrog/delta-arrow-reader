+            DataType::UInt64,
+            DataType::Float32,
+            DataType::Float64,
+        ] {
+            let values = cast(&base, &dt)?;
+            let dictionary = Arc::new(DictionaryArray::try_new(
+                Int32Array::from_iter((0..8193).map(|i| (i % 5 != 0).then_some(i))),
+                Arc::clone(&values),
+            )?) as ArrayRef;
+            for length in [1, 4, 129] {
+                for haystack in [
+                    new_null_array(&dt, length),
+                    Arc::new(DictionaryArray::try_new(
+                        Int32Array::new_null(length),
+                        values.slice(1, 1),
+                    )?) as ArrayRef,
+                    Arc::new(DictionaryArray::try_new(
+                        Int32Array::from(vec![0; length]),
+                        new_null_array(&dt, 1),
+                    )?) as ArrayRef,
+                ] {
+                    for (kind, needle) in [
+                        ("empty", values.slice(1, 0)),
+                        ("one", values.slice(1, 1)),
+                        ("below_cutoff", values.slice(1, 8191)),
+                        ("at_cutoff", values.slice(1, 8192)),
+                        ("above_cutoff", Arc::clone(&values)),
+                        ("dictionary", Arc::clone(&dictionary)),
+                        ("scalar", Arc::clone(&values)),
+                        ("scalar_null", Arc::clone(&values)),
+                    ] {
+                        let schema = Arc::new(Schema::new(vec![Field::new(
+                            "a",
+                            needle.data_type().clone(),
+                            true,
+                        )]));
+                        let batch =
+                            RecordBatch::try_new(Arc::clone(&schema), vec![needle])?;
+                        let input = match kind {
+                            "scalar" => lit(ScalarValue::try_from_array(&values, 1)?),
+                            "scalar_null" => {
+                                lit(ScalarValue::try_from_array(&values, 0)?)
+                            }
+                            _ => col("a", &schema)?,
+                        };
+                        for negated in [false, true] {
+                            for factory in ["array", "literals", "constant_casts"] {
+                                let expr = if factory == "array" {
+                                    InListExpr::try_new_from_array(
+                                        Arc::clone(&input),
+                                        Arc::clone(&haystack),
+                                        negated,
+                                        &schema,
+                                    )?
+                                } else {
+                                    let list = (0..length)
+                                        .map(|i| {
+                                            let literal =
+                                                lit(ScalarValue::try_from_array(
+                                                    &haystack, i,
+                                                )?);
+                                            Ok(if factory == "constant_casts" {
+                                                Arc::new(
+                                                    crate::expressions::CastExpr::new(
+                                                        literal,
+                                                        haystack.data_type().clone(),
+                                                        None,
+                                                    ),
+                                                )
+                                                    as Arc<dyn PhysicalExpr>
+                                            } else {
+                                                literal
+                                            })
+                                        })
+                                        .collect::<Result<Vec<_>>>()?;
+                                    InListExpr::try_new(
+                                        Arc::clone(&input),
+                                        list,
+                                        negated,
+                                        &schema,
+                                    )?
+                                };
+                                assert_eq!(
+                                    expr.static_filter.as_ref().unwrap().null_count(),
+                                    length,
+                                    "{dt:?} {kind} {factory} haystack={haystack:?}"
+                                );
+                                assert!(expr.nullable(&schema)?);
+                                let expr = Arc::new(expr) as Arc<dyn PhysicalExpr>;
+                                let rewritten = Arc::clone(&expr).with_new_children(
+                                    expr.children().into_iter().cloned().collect(),
+                                )?;
+                                for expr in [expr, rewritten] {
+                                    let actual = expr
+                                        .evaluate(&batch)?
+                                        .into_array(batch.num_rows())?;
+                                    assert_eq!(
+                                        as_boolean_array(&actual),
+                                        &BooleanArray::new_null(batch.num_rows()),
+                                        "{dt:?} {kind} {factory} length={length} negated={negated}",
+                                    );
+                                    checks += 1;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        assert_eq!(checks, 8640);
+        Ok(())
+    }
