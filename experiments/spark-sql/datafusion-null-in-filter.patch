+    #[test]
+    fn all_null_lists_preserve_errors_and_controls() -> Result<()> {
+        use arrow::array::new_null_array;
+        use arrow::compute::cast;
+
+        let base = Arc::new(Int32Array::from(vec![Some(1), None, Some(2)])) as ArrayRef;
+        let mixed = Arc::new(Int32Array::from(vec![Some(1), None])) as ArrayRef;
+        let error_schema =
+            Arc::new(Schema::new(vec![Field::new("a", DataType::Utf8, false)]));
+        let error_batch = RecordBatch::try_new(
+            Arc::clone(&error_schema),
+            vec![Arc::new(StringArray::from(vec!["invalid"]))],
+        )?;
+        for dt in [
+            DataType::Int8,
+            DataType::Int16,
+            DataType::Int32,
+            DataType::Int64,
+            DataType::UInt8,
+            DataType::UInt16,
+            DataType::UInt32,
+            DataType::UInt64,
+            DataType::Float32,
+            DataType::Float64,
+        ] {
+            let values = cast(&base, &dt)?;
+            let schema = Arc::new(Schema::new(vec![Field::new("a", dt.clone(), true)]));
+            let batch = RecordBatch::try_new(Arc::clone(&schema), vec![values])?;
+            let failing_input = crate::expressions::cast(
+                col("a", &error_schema)?,
+                &error_schema,
+                dt.clone(),
+            )?;
+            let expected_error = failing_input
+                .evaluate(&error_batch)
+                .unwrap_err()
+                .to_string();
+            for negated in [false, true] {
+                for (haystack, expected) in [
+                    (
+                        new_null_array(&dt, 0),
+                        vec![Some(negated), None, Some(negated)],
+                    ),
+                    (cast(&mixed, &dt)?, vec![Some(!negated), None, None]),
+                ] {
+                    let expr = InListExpr::try_new_from_array(
+                        col("a", &schema)?,
+                        haystack,
+                        negated,
+                        &schema,
+                    )?;
+                    let actual = expr.evaluate(&batch)?.into_array(batch.num_rows())?;
+                    assert_eq!(as_boolean_array(&actual), &BooleanArray::from(expected));
+                }
+                let haystack = new_null_array(&dt, 4);
+                let literals = (0..4)
+                    .map(|i| ScalarValue::try_from_array(&haystack, i).map(lit))
+                    .collect::<Result<Vec<_>>>()?;
+                for expr in [
+                    InListExpr::try_new_from_array(
+                        Arc::clone(&failing_input),
+                        Arc::clone(&haystack),
+                        negated,
+                        &error_schema,
+                    )?,
+                    InListExpr::try_new(
+                        Arc::clone(&failing_input),
+                        literals.clone(),
+                        negated,
+                        &error_schema,
+                    )?,
+                ] {
+                    assert_eq!(
+                        expr.evaluate(&error_batch).unwrap_err().to_string(),
+                        expected_error
+                    );
+                }
+                // Type validation must still reject typed NULL lists before construction.
+                assert!(
+                    InListExpr::try_new_from_array(
+                        col("a", &error_schema)?,
+                        haystack,
+                        negated,
+                        &error_schema
+                    )
+                    .is_err()
+                );
+                assert!(
+                    InListExpr::try_new(
+                        col("a", &error_schema)?,
+                        literals,
+                        negated,
+                        &error_schema
+                    )
+                    .is_err()
+                );
+            }
+        }
+        Ok(())
+    }
 
