  "reproduction": {
    "command": "python3 analyze.py",
    "directory": "/home/hanbo/.cache/delta-reader-spark-planning/float-type-branch-time-9853a0d",
    "script": "\"\"\"Describe time distribution using every sample in the existing archive.\"\"\"\nimport datetime\nimport gzip\nimport hashlib\nimport json\nfrom pathlib import Path\n\np = Path(__file__).parent\nrepo = Path('/home/hanbo/repo/delta-arrow-reader/experiments/spark-sql')\nload = lambda f: json.loads(f.read_text())\nsha = lambda f: hashlib.sha256(Path(f).read_bytes()).hexdigest()\nreferences = load(p / 'references.json')\nfor record in references.values():\n    assert sha(record['path']) == record['sha256']\nreference = load(repo / 'float-type-branch-record-results.json')\nraw_bytes = gzip.decompress((repo / reference['raw_data']['file']).read_bytes())\nassert hashlib.sha256(raw_bytes).hexdigest() == reference['raw_data']['uncompressed_sha256']\nraw = json.loads(raw_bytes)\nordinary = raw['metadata']['collection-decoded']\nbranches = raw['metadata']['collection-branches']\nhot = raw['metadata']['hot-symbol']\n\n\ndef bin_index(time, start, end):\n    assert start <= time <= end and end > start\n    return min(9, (time - start) * 10 // (end - start))\n\n\nassert [bin_index(t, 10, 110) for t in [10, 19, 20, 109, 110]] == [0, 0, 1, 9, 9]\nfor invalid in [9, 111]:\n    try:\n        bin_index(invalid, 10, 110)\n    except AssertionError:\n        pass\n    else:\n        raise AssertionError('Out-of-phase sample accepted')\n\nruns = []\nfor run in ordinary['runs']:\n    prefix = f\"collection/{run['directory']}/slot-{run['slot']}/\"\n    observation = json.loads(raw['files'][prefix + 'observation.json']['content'])\n    assert [r['command'] for r in observation] == ['enable', 'disable']\n    start = observation[0]['snapshot']['read_start_ns']\n    end = observation[1]['snapshot']['read_end_ns']\n    inner_start = observation[0]['snapshot']['read_end_ns']\n    inner_end = observation[1]['snapshot']['read_start_ns']\n    stack_run = next(r for r in branches['runs'] if (r['directory'], r['slot']) == (run['directory'], run['slot']))\n    hot_start = int(stack_run['hot_runtime_address'], 16)\n    lines = [line.split() for line in raw['files'][prefix + 'decoded-branches.txt']['content'].splitlines() if line.strip()]\n    assert len(lines) == len(run['samples'])\n    bins = [{name: 0 for name in ['event_samples', 'hot_event_ips', 'tag_mispredicted_entries', 'equality_mispredicted_entries']} for _ in range(10)]\n    boundary_samples = 0\n    for sample, line in zip(run['samples'], lines):\n        pid, tid = map(int, line[0].split('/'))\n        cpu = int(line[1].strip('[]'))\n        sec, nanos = line[2].removesuffix(':').split('.')\n        timestamp = int(sec) * 10**9 + int(nanos)\n        assert (pid, tid, cpu, timestamp, int(line[3]), line[5]) == tuple(sample[k]\n            for k in ['pid', 'tid', 'cpu', 'timestamp_ns', 'period', 'ip'])\n        assert line[4] == 'branch-misses:u:' and sample['period'] == 10007\n        bucket = bins[bin_index(timestamp, start, end)]\n        bucket['event_samples'] += 1\n        bucket['hot_event_ips'] += sample['symbol'] == hot['symbol']\n        boundary_samples += not (inner_start <= timestamp <= inner_end)\n        for token in line[6:]:\n            fields = token.split('/')\n            assert len(fields) == 8 and fields[2] in ['M', 'P', 'N', '-']\n            if fields[2] == 'M':\n                offset = int(fields[0], 16) - hot_start\n                bucket['tag_mispredicted_entries'] += offset == 0xa9\n                bucket['equality_mispredicted_entries'] += offset == 0xca\n    assert sum(b['event_samples'] for b in bins) == run['sample_count']\n    assert sum(b['hot_event_ips'] for b in bins) == run['symbols'][hot['symbol']]\n    for offset, key in [('0xa9', 'tag_mispredicted_entries'), ('0xca', 'equality_mispredicted_entries')]:\n        expected = sum(r['recorded_entries'] for r in stack_run['hot_offset_counts'] if r['from_offset'] == offset and r['prediction'] == 'M')\n        assert sum(b[key] for b in bins) == expected\n    duration_seconds = (end - start) / 1e9\n    early = sum(b['event_samples'] for b in bins[:2])\n    late = sum(b['event_samples'] for b in bins[2:])\n    runs.append({k: run[k] for k in ['directory', 'seed_index', 'slot', 'sample_count']} | {\n        'phase_start_ns': start, 'phase_end_ns': end, 'duration_seconds': duration_seconds,\n        'start_boundary_uncertainty_ns': inner_start - start,\n        'end_boundary_uncertainty_ns': end - inner_end,\n        'samples_in_uncertain_boundary_intervals': boundary_samples, 'bins': bins,\n        'first_20_pct': {'samples': early, 'samples_per_second': early / (.2 * duration_seconds)},\n        'remaining_80_pct': {'samples': late, 'samples_per_second': late / (.8 * duration_seconds)}})\nassert len(runs) == 16 and sum(r['sample_count'] for r in runs) == 11080\nresult = {'slice': 'Inspect the time distribution of existing branch-miss profiles',\n    'base_commit': '9853a0d', 'created_utc': datetime.datetime.now(datetime.UTC).isoformat(),\n    'method': load(p / 'protocol.json'), 'runs': runs,\n    'summary': {'processes': len(runs), 'samples': sum(r['sample_count'] for r in runs),\n        'candidate_tag_mispredicted_history_entries': sum(b['tag_mispredicted_entries'] for r in runs for b in r['bins']),\n        'equality_mispredicted_history_entries': sum(b['equality_mispredicted_entries'] for r in runs for b in r['bins']),\n        'samples_in_uncertain_boundary_intervals': sum(r['samples_in_uncertain_boundary_intervals'] for r in runs),\n        'new_measurements': 0, 'discarded_samples': 0, 'new_builds': 0},\n    'references': references, 'reproduction': {'command': 'python3 analyze.py',\n        'directory': str(p), 'script': Path(__file__).read_text()}}\n(p / 'analysis.json').write_text(json.dumps(result, indent=2) + '\\n')\nfor r in runs:\n    print(r['directory'], r['slot'], [b['event_samples'] for b in r['bins']],\n        'early/late samples per second', round(r['first_20_pct']['samples_per_second'], 1),\n        round(r['remaining_80_pct']['samples_per_second'], 1))\n",
    "setup": "Extract the embedded script, method and references as analyze.py, protocol.json and references.json into one directory. Use the hash-verified prior branch-record archive from the referenced experiment directory; no recollection or Rust build is needed."
  },
