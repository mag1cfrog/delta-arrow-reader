{
  "slice": "Inspect the time distribution of existing branch-miss profiles",
  "base_commit": "9853a0d",
  "created_utc": "2026-09-22T05:00:31.001590+00:00",
  "method": {
    "base_commit": "9853a0d",
    "phase": "post-collection descriptive analysis of all 16 previously recorded native profiles",
    "question": "Are the differences in branch-miss sample counts confined to the start of execution, or also visible later in the same phase?",
    "method": "Use the retained outer observer time bounds and ten equal wall-time bins for every process. Retain all samples; count total event samples, hot-loop event IPs, and recorded mispredicted history entries from candidate-tag and full-key-equality branches. Summarize the first two bins and remaining eight with their durations. Check the original total counts and all decoded sample identities.",
    "limits": [
      "The bins use wall time, not query boundaries or equal retired-instruction counts.",
      "Fixed-period interrupt samples and finite branch histories do not identify unique branches or a population misprediction rate.",
      "This is a post-collection descriptive review, not a new causal or performance-effect test. It must not change the earlier adoption decision, delete early samples or choose a new warmup count from the outcome."
    ],
    "new_measurements": false,
    "new_builds": false,
    "discarded_samples": 0
  },
