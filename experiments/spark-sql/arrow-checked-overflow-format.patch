+// Keep formatting arguments out of the successful arithmetic loop. Returning
+// only the text lets callers construct a statically known error variant.
+#[cold]
+#[inline(never)]
+fn overflow_message<T: std::fmt::Debug>(left: T, right: T, op: char) -> String {
+    format!("Overflow happened on: {left:?} {op} {right:?}")
+}
