    "identity": "Byte-identical frozen before/after release executables, original randomized native IN hasher, default allocator and ASLR. No temporary Rust type switch, fixed seed or benchmark rebuild.",
    "controller_change": "Reuse the existing perf FIFO acknowledgments to hold each process after planning and after execution. Native query execution is unchanged.",
    "observer_patch": "--- a/phase_observer.py\n+++ b/phase_observer.py\n@@ -48,6 +48,9 @@\n         self.directory.mkdir(exist_ok=True)\n         self.records, self.errors = [], []\n         self.ready = threading.Event()\n+        self.prepared, self.start = threading.Event(), threading.Event()\n+        self.completed, self.finish = threading.Event(), threading.Event()\n+        self.cancelled = threading.Event()\n         self.fds = []\n         for file in [self.directory / 'control', self.directory / 'ack']:\n             if not file.exists():\n@@ -80,6 +83,11 @@\n                 while (command := control.readline()) != b'stop\\n':\n                     assert command in [b'enable\\n', b'disable\\n'], command\n                     self.ready.wait()\n+                    if command == b'enable\\n':\n+                        self.prepared.set()\n+                        assert self.start.wait(60), 'Scheduled start timed out'\n+                        if self.cancelled.is_set():\n+                            break\n                     pid = self.benchmark_pid()\n                     if command == b'disable\\n':\n                         record = snapshot(pid, [self.cpu, self.sibling])\n@@ -91,6 +99,11 @@\n                     if command == b'enable\\n':\n                         record = snapshot(pid, [self.cpu, self.sibling])\n                     self.records.append({'command': command.decode().strip(), 'pid': pid, 'snapshot': record})\n+                    if command == b'disable\\n':\n+                        self.completed.set()\n+                        assert self.finish.wait(60), 'Scheduled finish timed out'\n+                        if self.cancelled.is_set():\n+                            break\n                     os.write(self.fds[1], b'ack\\n')\n         except Exception as error:\n             self.errors.append(repr(error))\n@@ -103,5 +116,7 @@\n         for fd in self.fds:\n             os.close(fd)\n         assert not self.errors, self.errors\n+        if self.cancelled.is_set():\n+            return\n         assert [r['command'] for r in self.records] == ['enable', 'disable']\n         assert self.records[0]['pid'] == self.records[1]['pid']\n",
