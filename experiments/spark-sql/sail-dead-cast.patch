+fn has_cast(expr: &Expr) -> Result<bool> {
+    expr.exists(|e| Ok(matches!(e, Expr::Cast(_))
+        || matches!(e, Expr::ScalarFunction(f) if f.func.inner().is::<sail_function::scalar::spark_cast_string_to_float::SparkCastStringToFloat>())))
